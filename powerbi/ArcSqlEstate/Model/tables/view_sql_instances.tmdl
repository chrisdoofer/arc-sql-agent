			    TRUE(),
			    ISBLANK([sql_patches_behind_count]), "Unknown",
			    [sql_patches_behind_count] = 0, "Ok",
			    [sql_patches_behind_count] <= 10, "Behind",
			    [sql_patches_behind_count] > 10, "Outdated",
			    "Unknown"
			)
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

