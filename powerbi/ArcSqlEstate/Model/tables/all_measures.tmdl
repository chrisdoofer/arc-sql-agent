	/// Standard and Enterprise Database Engine cores used for SA/AHB reconciliation; SSIS and free editions are excluded.
	measure kpi_engine_licensable_cores =
			CALCULATE (
			    SUM ( view_sql_instances[licensable_cores] ),
			    KEEPFILTERS ( LOWER ( TRIM ( COALESCE ( view_sql_instances[service_type], "" ) ) ) = "engine" ),
			    KEEPFILTERS (
			        CONTAINSSTRING ( LOWER ( COALESCE ( view_sql_instances[sql_edition], "" ) ), "enterprise" )
			            || CONTAINSSTRING ( LOWER ( COALESCE ( view_sql_instances[sql_edition], "" ) ), "standard" )
			    )
