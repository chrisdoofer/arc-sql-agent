	measure discount_azure_run_cost = ([azure_run_cost] /100)*44.8741
		displayFolder: kpi\esu\azure

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure azure_run_cost_discount =
			
			VAR selected_discount_SQL = SELECTEDVALUE(dim_sql_savings_plan[type], "None - Pay As You Go")
			VAR selected_discount_Server = SELECTEDVALUE(dim_server_savings_plan[type], "None - Pay As You Go")
			
			-- Get SQL discount
			VAR sql_discount =
			    CALCULATE(
			        MAX(dim_sql_savings_plan[discount]),
			        TREATAS({ selected_discount_SQL }, dim_sql_savings_plan[type])
			    )
			
			-- Get Server (VM) discount
			VAR server_discount =
			    CALCULATE(
			        MAX(dim_server_savings_plan[discount]),
			        TREATAS({ selected_discount_Server }, dim_server_savings_plan[type])
			    )
			
			VAR ModernisationType = [azure_modernisation_path]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ModernisationType IN { "SQL DB", "SQL MI" }, sql_discount,
			        ModernisationType IN { "VM", "VM*" }, server_discount,
			        1.0
			    )
		displayFolder: kpi\esu\azure

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure azure_modernisation_type = ```
			
			IF (
			    HASONEVALUE(view_esu[resource_key]),
			    SWITCH (
			        [azure_modernisation_path],
			        "SQL MI", "PaaS",
			        "SQL DB", "PaaS",
			        "VM", "IaaS",
			        "VM*", "IaaS",
			        BLANK()
			    ),
			    BLANK()
			)
			
			```
		displayFolder: kpi\esu\azure

	measure azure_modernisation_path =
			
			VAR Strategy =
			    SELECTEDVALUE ( dim_migration_strategy[migration_strategy], "Modernize to PaaS" )
			
			-- Pull from the *bridge* row that the visual is rendering
			VAR db_status = SELECTEDVALUE ( view_esu[db_status] )
			VAR mi_status = SELECTEDVALUE ( view_esu[mi_status] )
			VAR vm_status = SELECTEDVALUE ( view_esu[vm_status] )
			
			VAR db_cost = SELECTEDVALUE ( view_esu[db_total_cost] )
			VAR mi_cost = SELECTEDVALUE ( view_esu[mi_total_cost] )
			VAR vm_cost = SELECTEDVALUE ( view_esu[vm_total_cost] )
			
			VAR db_ready = db_status = "Ready" && NOT ISBLANK ( db_cost )
			VAR mi_ready = mi_status = "Ready" && NOT ISBLANK ( mi_cost )
			VAR vm_ready = vm_status = "Ready" && NOT ISBLANK ( vm_cost )
			
			VAR CheapestReady =
			    SWITCH (
			        TRUE(),
			        db_ready && (NOT mi_ready || db_cost <= mi_cost) && (NOT vm_ready || db_cost <= vm_cost), "SQL DB",
			        mi_ready && (NOT db_ready || mi_cost <= db_cost) && (NOT vm_ready || mi_cost <= vm_cost), "SQL MI",
			        vm_ready, "VM",
			        "VM*"
			    )
			
			VAR PaasChoice =
			    SWITCH ( TRUE(),
			        db_ready, "SQL DB",
			        mi_ready, "SQL MI",
			        vm_ready, "VM",
			        "VM*"
			    )
			
			RETURN
			    IF ( Strategy = "Minimize cost", CheapestReady, PaasChoice )
		displayFolder: kpi\esu\azure

	measure azure_run_cost_monthly =
			
			CALCULATE(
			    SUMX(
			        view_esu,
			        VAR mstatus = [azure_modernisation_path]
			        VAR cores = MAX(COALESCE([logical_cores], 0), 2)
			
			        VAR mi_compute = COALESCE([mi_compute_cost], 0)
			        VAR db_compute = COALESCE([db_compute_cost], 0)
			        VAR vm_compute = COALESCE([vm_compute_cost], 0)
			
			        VAR mi_storage = COALESCE([mi_storage_cost], 0)
			        VAR db_storage = COALESCE([db_storage_cost], 0)
			        VAR vm_storage = COALESCE([vm_storage_cost], 0)
			
			        VAR discount = COALESCE([azure_run_cost_discount], 1)
			        VAR user_db_count = COALESCE([user_db_count], 0)
			
			        VAR compute_cost =
			            SWITCH(
			                TRUE(),
			                mstatus = "VM*", IF(cores > 2, 47.5 * cores, 47.5),
			                mstatus = "VM", vm_compute,
			                mstatus = "SQL MI", mi_compute,
			                mstatus = "SQL DB", db_compute,
			                0
			            )
			
			        VAR storage_cost =
			            SWITCH(
			                TRUE(),
			                mstatus = "VM*", 25,
			                mstatus = "VM", vm_storage,
			                mstatus = "SQL MI", mi_storage,
			                mstatus = "SQL DB", db_storage,
			                0
			            )
			
			        RETURN (compute_cost * discount + storage_cost)
			    )
			)
		displayFolder: kpi\esu\azure

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure azure_run_cost_quarterly = ```
			
			CALCULATE(
			    [azure_run_cost_monthly] * 3,
			    REMOVEFILTERS(dim_period_selector) // Ignore slicer if needed
			)
			
			
			```
		displayFolder: kpi\esu\azure

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure sql_patch_status_pct =
			
