	measure server_esu_cost_total = ```
			
			VAR SelectedMonths =
			    SELECTEDVALUE(dim_period_selector[months], 0)
			RETURN
			SUMX(
			    FILTER(
			        view_esu,
			        view_esu[resource_type_group] = "Arc"
			            && view_esu[esu_status] ="True"
			    ),
			    VAR Cores = view_esu[os_esu_cores]
			    RETURN
			        COALESCE( Cores * view_esu[os_esu_basecost_monthly] * SelectedMonths, 0)
			)
			
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: kpi\esu

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// SQL Server ESU cost from lifecycle pricing and observed licensable cores. Owned Software Assurance does not automatically alter this source estimate.
	measure sql_esu_cost_total = ```
			
			VAR SelectedMonths =
			    SELECTEDVALUE(dim_period_selector[months], 0)
			RETURN
			SUMX(
			    FILTER(
			        view_esu,
			        view_esu[resource_type_group] = "Arc"
			            && view_esu[esu_status] = "True"
			    ),
			    VAR Cores = view_esu[sql_esu_cores]
			    RETURN
			        COALESCE( Cores * view_esu[sql_esu_basecost_monthly] * SelectedMonths, 0 )
			)
			
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: kpi\esu

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Azure target run cost sourced from Azure migration evidence. Owned Software Assurance does not automatically alter this source estimate.
	measure azure_run_cost =
			
			SUMX (
			    view_esu,
			    VAR mstatus = [azure_modernisation_path]
			    VAR months = SELECTEDVALUE ( dim_period_selector[months], 1 )
			    VAR cores = MAX ( COALESCE ( [logical_cores], 0 ), 2 )
			
			    VAR mi_compute = COALESCE ( [mi_compute_cost], 0 )
			    VAR db_compute = COALESCE ( [db_compute_cost], 0 )
			    VAR vm_compute = COALESCE ( [vm_compute_cost], 0 )
			
			    VAR mi_storage = COALESCE ( [mi_storage_cost], 0 )
			    VAR db_storage = COALESCE ( [db_storage_cost], 0 )
			    VAR vm_storage = COALESCE ( [vm_storage_cost], 0 )
			
			    VAR discount = COALESCE ( [azure_run_cost_discount], 1 )
			
			    VAR user_db_count = COALESCE ( [user_db_count], 0 )
			
			    VAR compute_cost =
			        SWITCH (
			            TRUE(),
			            mstatus = "VM*", IF ( cores > 2, 47.5 * cores, 47.5 ),
			            mstatus = "VM",    vm_compute,
			            mstatus = "SQL MI", mi_compute,
			            mstatus = "SQL DB", db_compute,
			            0
			        )
			
			    VAR storage_cost =
			        SWITCH (
			            TRUE(),
			            mstatus = "VM*", 25,
			            mstatus = "VM",    vm_storage,
			            mstatus = "SQL MI", mi_storage,
			            mstatus = "SQL DB", db_storage,
			            0
			        )
			
			    VAR total_cost = ( compute_cost * discount + storage_cost ) * months
			    RETURN total_cost
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: kpi\esu\azure

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure total_esu_cost = ```
			[server_esu_cost_total] + [sql_esu_cost_total] 
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: kpi\esu

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Difference between reported ESU cost and reported Azure target run cost. Software Assurance and Azure Hybrid Benefit savings are not automatically applied.
	measure azure_saving_vs_esu = [total_esu_cost]-[azure_run_cost]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: kpi\esu

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure azure_saving_vs_esu_pct = ```
			
			VAR esu_cost = [total_esu_cost]  -- your existing ESU cost measure
			VAR modern_cost = [azure_run_cost]  -- the new modernisation cost measure
			RETURN
			    DIVIDE(esu_cost - modern_cost, esu_cost, 0)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: kpi\esu

	measure azure_ready_pct = ```
			
			VAR total = COUNTROWS(view_esu)
			VAR ready =
			    CALCULATE(
			        COUNTROWS(view_esu),
			        view_esu[azure_modernisation_status] IN { "VM", "SQL MI", "SQL DB", "VM*"}
			    )
			RETURN
			    DIVIDE(ready, total, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: kpi\esu\azure

	measure azure_paas_ready_pct = ```
			
			DIVIDE(
			    CALCULATE(COUNTROWS(view_esu), view_esu[azure_modernisation_type] = "PaaS"),
			    COUNTROWS(view_esu)
			)
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: kpi\esu\azure

	measure os_esu_cost_by_quarter_full_timeline = ```
			
			VAR QuarterStart = STARTOFQUARTER('dim_date'[Date])
			VAR QuarterEnd = ENDOFQUARTER('dim_date'[Date])
			
			RETURN
			SUMX(
			    view_esu,
			    VAR MonthlyCost = [os_esu_basecost_monthly]
			    VAR Cores = [os_esu_cores]
			    VAR ESUStart = [os_esu_start_date]
			    VAR ESUEnd = [os_esu_end_date]
			    VAR Overlaps =
			        NOT (
			            QuarterEnd < ESUStart || QuarterStart > ESUEnd
			        )
			    RETURN
			        IF(Overlaps, MonthlyCost * Cores * 3, 0)
			)
			
			
			```
		displayFolder: kpi\esu

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure sql_esu_cost_by_quarter_full_timeline = ```
			
			VAR QuarterStart = STARTOFQUARTER('dim_date'[Date])
			VAR QuarterEnd = ENDOFQUARTER('dim_date'[Date])
			
			RETURN
			SUMX(
			    view_esu,
			    VAR MonthlyCost = [sql_esu_basecost_monthly]
			    VAR Cores = [sql_esu_cores]
			    VAR ESUStart = [sql_esu_start_date]
			    VAR ESUEnd = [sql_esu_end_date]
			    VAR Overlaps =
			        NOT (
			            QuarterEnd < ESUStart || QuarterStart > ESUEnd
			        )
			    RETURN
			        IF(Overlaps, MonthlyCost * Cores * 3, 0)
			)
			
			```
		displayFolder: kpi\esu

		annotation PBI_FormatHint = {"isGeneralNumber":true}

