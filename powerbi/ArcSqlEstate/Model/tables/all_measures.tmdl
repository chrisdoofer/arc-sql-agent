	/// Number of failed best-practice check results.
	measure kpi_bpa_fail_count = CALCULATE ( COUNTROWS ( 'view_best_practice_findings' ), KEEPFILTERS ( 'view_best_practice_findings'[status] = "Fail" ) )
		formatString: #,##0
		displayFolder: Best Practices
