	/// Optional annualized customer price per Enterprise core for a new licence with Software Assurance.
	measure kpi_enterprise_license_sa_annual_cost_per_core = MAX ( licensing_inputs[enterprise_license_sa_annual_cost_per_core] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
