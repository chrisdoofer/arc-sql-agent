	/// Number of warning best-practice check results.
	measure kpi_bpa_warning_count = CALCULATE ( COUNTROWS ( 'view_best_practice_findings' ), KEEPFILTERS ( 'view_best_practice_findings'[status] = "Warning" ) )
		formatString: #,##0
		displayFolder: Best Practices
		lineageTag: 0f9b0883-0344-4494-a7b8-f5ba8d7e4df5

	/// Number of best-practice check results that could not be assessed from connected evidence.
	measure kpi_bpa_not_assessed_count = CALCULATE ( COUNTROWS ( 'view_best_practice_findings' ), KEEPFILTERS ( 'view_best_practice_findings'[status] = "Not Assessed" ) )
		formatString: #,##0
		displayFolder: Best Practices
		lineageTag: 87acadcf-b7ee-4cc4-8ce6-6e584d260fd3

	/// Distinct machines with at least one failed or warning best-practice result.
	measure kpi_bpa_affected_machine_count = CALCULATE ( DISTINCTCOUNT ( 'view_best_practice_findings'[machine_name] ), KEEPFILTERS ( 'view_best_practice_findings'[status] IN { "Fail", "Warning" } ) )
		formatString: #,##0
		displayFolder: Best Practices
