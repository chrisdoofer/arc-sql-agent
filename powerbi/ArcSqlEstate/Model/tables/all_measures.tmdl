			RETURN
			DIVIDE(VMReady, Total, 0)
			
			```
		isHidden
		displayFolder: kpi\esu

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure os_vm_migration_ready_% = ```
			
			VAR Total = COUNTROWS(ext_arc_servers)
			VAR VMReady =
			    CALCULATE(
			        COUNTROWS(ext_arc_servers),
			        SEARCH("Virtual Machine", ext_arc_servers[Model], 1, 0) > 0
			    )
			RETURN
			DIVIDE(VMReady, Total, 0)
			
			```
		formatString: 0%;-0%;0%
		isHidden
		displayFolder: kpi\esu

		changedProperty = IsHidden

	measure total_resources = COUNTROWS('fact_resources')
