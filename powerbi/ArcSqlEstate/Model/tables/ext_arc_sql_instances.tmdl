	column last_inventory_upload_hrs = ```
			
			VAR t = ext_arc_sql_instances[last_inventory_upload_time] 
			RETURN IF ( NOT ISBLANK(t), DATEDIFF ( t, NOW(), HOUR ) )
			```
		isHidden
