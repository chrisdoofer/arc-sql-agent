	column resource_key = RELATED ( fact_keys[resource_key] )
		formatString: 0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column parent_resource_key = ```
			
			LOOKUPVALUE(
			    fact_keys[resource_key],
			    fact_keys[resource_id], [parent_resource_id]
			)
			
			```
		formatString: 0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition ext_arc_sql_instances = m
		mode: import
		queryGroup: 'Extenal-Resource Graph'
		source =
				let
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 0) Helpers (ultralean + defensive)
				    // ─────────────────────────────────────────────────────────────────────────────
				    ToText = (x as nullable any) as nullable text =>
				        if x is null then null else if x is text then x else try Text.From(x) otherwise null,
				
				    NormId = (x as nullable any) as nullable text =>
				        let t = ToText(x) in if t is null then null else Text.Lower(Text.Trim(t)),
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 1) ARG call (all flattening done in KQL)
				    // ─────────────────────────────────────────────────────────────────────────────
				    SourceRaw = AzureResourceGraph.Query(
				    "
				        resources
				        | where type == 'microsoft.azurearcdata/sqlserverinstances'
				        | extend props = properties
				        | extend resource_id = trim(' ', tolower(id)), parent_id = trim(' ', tolower(tostring(props.containerResourceId))), patch = tostring(props.patchLevel)
				        | join kind=leftouter (
				            resources
				            | where type == 'microsoft.hybridcompute/machines/extensions'
				            | where properties.type in ('WindowsAgent.SqlServer','LinuxAgent.SqlServer')
				            | extend machineId = tolower(substring(id, 0, indexof(id, '/extensions/')))
				            | project machineId, Extension_License_Type = tostring(properties.settings.LicenseType)
				        ) on $left.parent_id == $right.machineId
				        | extend p1 = indexof(patch, '.'), p2 = indexof(patch, '.', indexof(patch, '.') + 1)
				        | extend sql_patch_level_norm = iif(p1 >= 0 and p2 > p1, strcat(substring(patch, 0, p1 + 1), '0', substring(patch, p2, strlen(patch) - p2)), patch)
				        | summarize take_any(*) by id
				        | project
				            resource_id,
				            parent_resource_id = parent_id,
				            resource_name = name,
				            resource_type = type,
				            platform = 'Arc',
				            location = trim(' ', tolower(location)),
				            subscription_id = trim(' ', tolower(subscriptionId)),
				            resource_group = trim(' ', tolower(resourceGroup)),
				            provisioning_state = tostring(props.provisioningState),
				            sql_instance_name = name,
				            status = tostring(props.status),
				            azure_defender_status = tostring(props.azureDefenderStatus),
				            azure_defender_status_last_updated = todatetime(props.azureDefenderStatusLastUpdated),
				            last_inventory_upload_time = todatetime(props.lastInventoryUploadTime),
				            max_server_memory_mb = tolong(coalesce(props.maxServerMemoryMB, props.configuration.maxServerMemoryMB)),
				            last_usage_upload_time = todatetime(props.lastUsageUploadTime),
				            sql_license_type = Extension_License_Type,
				            sql_version = tostring(props.version),
				            sql_current_version = tostring(props.currentVersion),
				            sql_patch_level = tostring(sql_patch_level_norm),
				            sql_edition = tostring(props.edition),
				            vcore = toint(props.vCore),
				            cores = toint(props.cores),
				            db_master_key_exists = tobool(props.dbMasterKeyExists),
				            tcp_static_ports = tostring(props.tcpStaticPorts),
				            tcp_dynamic_ports = tostring(props.tcpDynamicPorts),
				            instance_name = tostring(props.instanceName),
				            collation = tostring(props.collation),
				            always_on_role = tostring(props.alwaysOnRole),
				            service_type = tostring(props.serviceType),
				            is_hadr_enabled = coalesce(tobool(props.isHadrEnabled), false),
				            monitoring_enabled = tobool(props.migration.assessment.enabled),
				            migration_enabled = tobool(props.migration.assessment.enabled),
				            assessment_upload_time = todatetime(props.migration.assessment.assessmentUploadTime),
				            backup_policy = tostring(props.backupPolicy),
				            is_fci = coalesce(tobool(props.failoverCluster), false),
				            client_connections = toint(props.clientConnection),
				            mi_blockers = toint(props.migration.assessment.skuRecommendationResults.azureSqlManagedInstance.numberOfServerBlockerIssues),
				            mi_status = tostring(props.migration.assessment.skuRecommendationResults.azureSqlManagedInstance.recommendationStatus),
				            mi_compute_cost = todouble(props.migration.assessment.skuRecommendationResults.azureSqlManagedInstance.monthlyCost.computeCost),
				            mi_storage_cost = todouble(props.migration.assessment.skuRecommendationResults.azureSqlManagedInstance.monthlyCost.storageCost),
				            mi_total_cost = todouble(props.migration.assessment.skuRecommendationResults.azureSqlManagedInstance.monthlyCost.totalCost),
				            vm_blockers = toint(props.migration.assessment.skuRecommendationResults.azureSqlVirtualMachine.numberOfServerBlockerIssues),
				            vm_status = tostring(props.migration.assessment.skuRecommendationResults.azureSqlVirtualMachine.recommendationStatus),
				            vm_compute_cost = todouble(props.migration.assessment.skuRecommendationResults.azureSqlVirtualMachine.monthlyCost.computeCost),
				            vm_storage_cost = todouble(props.migration.assessment.skuRecommendationResults.azureSqlVirtualMachine.monthlyCost.storageCost),
				            vm_total_cost = todouble(props.migration.assessment.skuRecommendationResults.azureSqlVirtualMachine.monthlyCost.totalCost),
				            db_blockers = toint(props.migration.assessment.skuRecommendationResults.azureSqlDatabase.numberOfServerBlockerIssues),
				            db_status = tostring(props.migration.assessment.skuRecommendationResults.azureSqlDatabase.recommendationStatus),
				            db_compute_cost = todouble(props.migration.assessment.skuRecommendationResults.azureSqlDatabase.monthlyCost.computeCost),
				            db_storage_cost = todouble(props.migration.assessment.skuRecommendationResults.azureSqlDatabase.monthlyCost.storageCost),
				            db_total_cost = todouble(props.migration.assessment.skuRecommendationResults.azureSqlDatabase.monthlyCost.totalCost)
				            ",
				        null, null, null, [ resultTruncated = false ]
				    ),
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 2) Typed-empty fallback schema (no Table.Combine)
				    // ─────────────────────────────────────────────────────────────────────────────
				    Fallback = Table.FromRows(
				        {},
				        type table [
				            resource_id = text, parent_resource_id = text, resource_name = text, resource_type = text, platform = text, location = text,
				            subscription_id = text, resource_group = text, provisioning_state = text, sql_instance_name = text, status = text,
				            azure_defender_status = text, azure_defender_status_last_updated = datetime,
				            last_inventory_upload_time = datetime, max_server_memory_mb = Int64.Type, last_usage_upload_time = datetime,
				            sql_license_type = text, sql_version = text, sql_current_version = text,
				            sql_patch_level = text, sql_edition = text, vcore = Int64.Type, cores = Int64.Type,
				            db_master_key_exists = logical, tcp_static_ports = text, tcp_dynamic_ports = text,
				            instance_name = text, collation = text, always_on_role = text, service_type = text,
				            is_hadr_enabled = logical, monitoring_enabled = logical, migration_enabled = logical,
				            assessment_upload_time = datetime, backup_policy = text, is_fci = logical,
				            client_connections = Int64.Type, mi_blockers = Int64.Type, mi_status = text,
				            mi_compute_cost = number, mi_storage_cost = number, mi_total_cost = number,
				            vm_blockers = Int64.Type, vm_status = text, vm_compute_cost = number,
				            vm_storage_cost = number, vm_total_cost = number, db_blockers = Int64.Type,
				            db_status = text, db_compute_cost = number, db_storage_cost = number, db_total_cost = number
				        ]
				    ),
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 3) Schema guard (adds missing cols as null; keeps typed-empty when needed)
				    // ─────────────────────────────────────────────────────────────────────────────
				    SourceTable  = if Value.Is(SourceRaw, type table) then SourceRaw else Fallback,
				    SafeSelected = Table.SelectColumns(SourceTable, Table.ColumnNames(Fallback), MissingField.UseNull),
				    Validated    = if Table.IsEmpty(SafeSelected) then Fallback else SafeSelected,
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 3.1) Unique Guard (Local M-level deduplication safety net)
				    // ─────────────────────────────────────────────────────────────────────────────
				    Deduplicated = Table.Distinct(Validated, {"resource_id"}),
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 4) Final type assertion (keys are whole numbers; enforce Int64)
				    // ─────────────────────────────────────────────────────────────────────────────
				    Selected = Table.TransformColumnTypes(
				        Deduplicated,
				        {
				            {"vcore", Int64.Type},
				            {"cores", Int64.Type},
				            {"max_server_memory_mb", Int64.Type},
				            {"db_master_key_exists", type logical},
				            {"is_hadr_enabled", type logical},
				            {"monitoring_enabled", type logical},
				            {"migration_enabled", type logical},
				            {"is_fci", type logical},
				            {"client_connections", Int64.Type},
				            {"mi_blockers", Int64.Type},
				            {"mi_compute_cost", type number},
				            {"mi_storage_cost", type number},
				            {"mi_total_cost", type number},
				            {"vm_blockers", Int64.Type},
				            {"vm_compute_cost", type number},
				            {"vm_storage_cost", type number},
				            {"vm_total_cost", type number},
				            {"db_blockers", Int64.Type},
				            {"db_compute_cost", type number},
				            {"db_storage_cost", type number},
				            {"db_total_cost", type number},
				            {"azure_defender_status_last_updated", type datetime},
				            {"last_inventory_upload_time", type datetime},
				            {"last_usage_upload_time", type datetime},
				            {"assessment_upload_time", type datetime}
				        },
				        "en-GB"
				    )
				in
				    Selected

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
