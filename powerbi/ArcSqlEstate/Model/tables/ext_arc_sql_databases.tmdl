	column last_log_status = SWITCH( TRUE(), [recovery_mode] <> "Full", "N/A",ISBLANK([last_log_backup]), "Critical", [last_log_backup_hours] <= 1, "OK", [last_log_backup_hours] <= 24, "Warning", "Critical")
