	column parent_resource_key =
			
			LOOKUPVALUE(
			    fact_keys[resource_key],
			    fact_keys[resource_id], [parent_resource_id]
			)
		formatString: 0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition ext_arc_sql_databases = m
		mode: import
		queryGroup: 'Extenal-Resource Graph'
		source = ```
				let
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 0) Helpers (ultralean + defensive)
				    // ─────────────────────────────────────────────────────────────────────────────
				    ToText = (x as nullable any) as nullable text =>
				        if x is null then null else if x is text then x else try Text.From(x) otherwise null,
				
				    NormId = (x as nullable any) as nullable text =>
				        let t = ToText(x) in if t is null then null else Text.Lower(Text.Trim(t)),
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 1) ARG call (ARG-first normalization & projection)
				    // ─────────────────────────────────────────────────────────────────────────────
				    SourceRaw = AzureResourceGraph.Query(
				    "
				    resources
				    | where type == 'microsoft.azurearcdata/sqlserverinstances/databases'
				    | extend resource_id = trim(' ', tolower(id))
				    | extend parent_resource_id = trim(' ', tolower(split(resource_id, '/databases')[0]))
				    | summarize take_any(*) by id
				    | project
				        resource_id,
				        parent_resource_id,
				        resource_name       = trim(' ', tostring(name)),
				        platform            = 'Arc',
				        resource_type       = trim(' ', tostring(type)),   
				        sql_database_name   = trim(' ', tostring(name)),
				        location            = trim(' ', tostring(location)),
				        subscription_id     = trim(' ', tolower(subscriptionId)),
				        resource_group      = trim(' ', tostring(resourceGroup)),
				        provisioning_state  = tostring(properties.provisioningState),
				        status              = tostring(properties.state),
				        last_database_upload_time = todatetime(properties.lastDatabaseUploadTime),
				        database_creation_date    = todatetime(properties.databaseCreationDate),
				        compatibility_level       = tolong(coalesce(properties.compatibilityLevel, 0)),
				        last_full_backup          = todatetime(properties.backupInformation.lastFullBackup),
				        last_log_backup           = todatetime(properties.backupInformation.lastLogBackup),
				        space_available_mb        = tolong(coalesce(properties.spaceAvailableMB, 0)),
				        is_auto_update_stats_on       = iif(tobool(properties.databaseOptions.isAutoUpdateStatsOn) == true, 1, 0),
				        is_auto_create_stats_on       = iif(tobool(properties.databaseOptions.isAutoCreateStatsOn) == true, 1, 0),
				        is_memory_optimization_enabled= iif(tobool(properties.databaseOptions.isMemoryOptimizationEnabled) == true, 1, 0),
				        is_trustworthy_on             = iif(tobool(properties.databaseOptions.isTrustworthyOn) == true, 1, 0),
				        is_auto_shrink_on             = iif(tobool(properties.databaseOptions.isAutoShrinkOn) == true, 1, 0),
				        is_auto_close_on              = iif(tobool(properties.databaseOptions.isAutoCloseOn) == true, 1, 0),
				        is_encrypted                  = iif(tobool(properties.databaseOptions.isEncrypted) == true, 1, 0),
				        is_read_only                  = iif(tobool(properties.isReadOnly) == true, 1, 0),
				        collation_name           = tostring(properties.collationName),
				        recovery_mode            = tostring(properties.recoveryMode),
				        size_mb                  = tolong(coalesce(properties.sizeMB, 0)),
				        data_file_size_mb        = tolong(coalesce(properties.dataFileSizeMB, 0)),
				        log_file_size_mb         = tolong(coalesce(properties.logFileSizeMB, 0))
				    ",
				        null, null, null, [ resultTruncated = false ]
				    ),
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 2) Typed-empty fallback schema (no Table.Combine)
				    // ─────────────────────────────────────────────────────────────────────────────
				    Fallback = Table.FromRows(
				        {},
				        type table [
				            resource_id = text, parent_resource_id = text, resource_name = text, resource_type = text, platform = text, sql_database_name = text, location = text,
				            subscription_id = text, resource_group = text, provisioning_state = text, status = text,
				            last_database_upload_time = datetime, database_creation_date = datetime,
				            compatibility_level = Int64.Type,
				            last_full_backup = datetime, last_log_backup = datetime,
				            space_available_mb = Int64.Type,
				            is_auto_update_stats_on = Int64.Type, is_auto_create_stats_on = Int64.Type,
				            is_memory_optimization_enabled = Int64.Type, is_trustworthy_on = Int64.Type,
				            is_auto_shrink_on = Int64.Type, is_auto_close_on = Int64.Type,
				            is_encrypted = Int64.Type, is_read_only = Int64.Type,
				            collation_name = text, recovery_mode = text,
				            size_mb = Int64.Type, data_file_size_mb = Int64.Type, log_file_size_mb = Int64.Type
				        ]
				    ),
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 3) Schema guard (adds missing cols as null; keeps typed-empty when needed)
				    // ─────────────────────────────────────────────────────────────────────────────
				    SourceTable  = if Value.Is(SourceRaw, type table) then SourceRaw else Fallback,
				    SafeSelected = Table.SelectColumns(SourceTable, Table.ColumnNames(Fallback), MissingField.UseNull),
				    Validated    = if Table.IsEmpty(SafeSelected) then Fallback else SafeSelected,
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 3.1) Unique Guard (Local M-level deduplication safety net)
				    // ─────────────────────────────────────────────────────────────────────────────
				    Deduplicated = Table.Distinct(Validated, {"resource_id"}),
				
				    // ─────────────────────────────────────────────────────────────────────────────
				    // 4) Final type enforcement (single pass; Int64 + datetime + text)
				    // ─────────────────────────────────────────────────────────────────────────────
				    FinalTyped = Table.TransformColumnTypes(
				        Deduplicated,
				        {
				            // integers (KQL used tolong)
				            {"compatibility_level", Int64.Type},
				            {"space_available_mb", Int64.Type},
				            {"size_mb", Int64.Type},
				            {"data_file_size_mb", Int64.Type},
				            {"log_file_size_mb", Int64.Type},
				
				            // boolean flags emitted as 0/1 → keep as Int64 for model efficiency
				            {"is_auto_update_stats_on", Int64.Type},
				            {"is_auto_create_stats_on", Int64.Type},
				            {"is_memory_optimization_enabled", Int64.Type},
				            {"is_trustworthy_on", Int64.Type},
				            {"is_auto_shrink_on", Int64.Type},
				            {"is_auto_close_on", Int64.Type},
				            {"is_encrypted", Int64.Type},
				            {"is_read_only", Int64.Type},
				
				            // datetimes
				            {"last_database_upload_time", type datetime},
				            {"database_creation_date", type datetime},
				            {"last_full_backup", type datetime},
				            {"last_log_backup", type datetime}
				        },
				        "en-GB"
				    )
				in
				    FinalTyped
				```

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

