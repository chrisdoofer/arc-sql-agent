		isNameInferred
		sourceColumn: [location]

		annotation SummarizationSetBy = Automatic

	column subscription_id
		summarizeBy: none
		isNameInferred
		sourceColumn: [subscription_id]

		annotation SummarizationSetBy = Automatic

	column parent_resource_key
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [parent_resource_key]

		annotation SummarizationSetBy = User

	column instance_parent_resource_key
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [instance_parent_resource_key]

		annotation SummarizationSetBy = User

	column sql_instance_name
		summarizeBy: none
		isNameInferred
		sourceColumn: [sql_instance_name]

		annotation SummarizationSetBy = Automatic

