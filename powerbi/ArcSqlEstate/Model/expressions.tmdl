/// Returns exact Oracle Linux ELSA/CVE mappings from official Oracle Public Yum updateinfo metadata for missing package targets.
expression fnOracleLinuxPatchCveRows =
		(missingPatches as table) as list =>
		let
		    SupportedReleases = {"10", "9", "8", "7"},
		    RetryableStatusCodes = {429, 500, 502, 503, 504},
		    RpmArchitectures = {"x86_64", "aarch64", "ppc64le", "s390x", "noarch", "i686"},
		    NormalizeRpmVersion = (value as any) as text =>
		        let
		            Version = Text.Trim(Text.From(value)),
		            WithoutArchitecture = List.Accumulate(RpmArchitectures, Version, (state as text, architecture as text) => if Text.EndsWith(Text.Lower(state), "." & architecture) then Text.Start(state, Text.Length(state) - Text.Length(architecture) - 1) else state)
		        in
		            if Text.StartsWith(WithoutArchitecture, "0:") then Text.AfterDelimiter(WithoutArchitecture, ":") else WithoutArchitecture,
		    RelevantRows = Table.Buffer(Table.SelectRows(missingPatches, each Text.Lower(Text.Trim(Text.From([os_type]))) = "linux" and [os_distribution] = "Oracle Linux" and List.Contains(SupportedReleases, Text.Trim(Text.From([release_codename]))) and [patch_name] <> null and Text.Trim(Text.From([patch_name])) <> "" and [package_version] <> null and Text.Trim(Text.From([package_version])) <> "")),
		    TargetRecords = List.Buffer(Table.ToRecords(RelevantRows)),
		    MakeTargetKey = (target as record) as text => Text.Trim(Text.From(target[release_codename])) & "|" & Text.Lower(Text.Trim(Text.From(target[patch_name]))) & "|" & NormalizeRpmVersion(target[package_version]),
		    TargetKeys = List.Buffer(List.Distinct(List.Transform(TargetRecords, each MakeTargetKey(_)))),
		    TargetVersionsByKey = if List.IsEmpty(TargetKeys) then [] else Record.FromList(List.Transform(TargetKeys, (targetKey as text) => List.Distinct(List.Transform(List.Select(TargetRecords, each MakeTargetKey(_) = targetKey), each Text.Trim(Text.From([package_version]))))), TargetKeys),
		    EmptyXmlTable = #table({"Name", "Namespace", "Value", "Attributes"}, {}),
		    AsXmlTable = (value as any) as table => if value is table then value else EmptyXmlTable,
		    NodeChildren = (node as any) as table => if node is record then AsXmlTable(Record.FieldOrDefault(node, "Value", null)) else EmptyXmlTable,
		    NamedNodes = (nodes as any, elementName as text) as list =>
		        let
		            XmlTable = AsXmlTable(nodes),
		            Matches = if Table.HasColumns(XmlTable, {"Name"}) then Table.SelectRows(XmlTable, each Text.Lower(Text.From(Record.FieldOrDefault(_, "Name", ""))) = Text.Lower(elementName)) else EmptyXmlTable
		        in
		            Table.ToRecords(Matches),
		    FirstNamedNode = (nodes as any, elementName as text) as any => List.First(NamedNodes(nodes, elementName), null),
		    NodeText = (node as any) as text =>
		        let
		            Value = if node is record then Record.FieldOrDefault(node, "Value", null) else null,
		            DirectText = if Value is text then Text.Trim(Value) else if Value is number or Value is date or Value is datetime or Value is datetimezone then Text.Trim(Text.From(Value)) else "",
		            NestedText = if DirectText <> "" or not (Value is table) then "" else Text.Combine(List.RemoveNulls(List.Transform(Table.ToRecords(Value), each let NestedValue = Record.FieldOrDefault(_, "Value", null) in if NestedValue is text then Text.Trim(NestedValue) else null)), "")
		        in
		            if DirectText <> "" then DirectText else NestedText,
		    ElementText = (node as any, elementName as text) as text => NodeText(FirstNamedNode(NodeChildren(node), elementName)),
		    NodeAttribute = (node as any, attributeName as text) as text =>
		        let
		            Attributes = if node is record then Record.FieldOrDefault(node, "Attributes", null) else null,
		            AttributeTable = AsXmlTable(Attributes),
		            Matches = if Table.HasColumns(AttributeTable, {"Name"}) then Table.ToRecords(Table.SelectRows(AttributeTable, each Text.Lower(Text.From(Record.FieldOrDefault(_, "Name", ""))) = Text.Lower(attributeName))) else {},
		            Value = if List.IsEmpty(Matches) then "" else Text.Trim(Text.From(Record.FieldOrDefault(Matches{0}, "Value", "")))
		        in
		            Value,
		    FetchOracleBinary = (relativePath as text, context as text, optional attempt as nullable number) as binary =>
		        let
		            CurrentAttempt = if attempt = null then 0 else attempt,
		            Response = try Web.Contents("https://yum.oracle.com", [RelativePath = relativePath, ManualStatusHandling = RetryableStatusCodes]) otherwise null,
		            Status = if Response = null then 0 else Record.FieldOrDefault(Value.Metadata(Response), "Response.Status", 200),
		            Result = if Status = 200 then Binary.Buffer(Response) else if CurrentAttempt < 3 then Function.InvokeAfter(() => @FetchOracleBinary(relativePath, context, CurrentAttempt + 1), #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))) else error Error.Record("OracleLinuxSecurityFeedUnavailable", "Oracle Public Yum security metadata could not be retrieved after four attempts.", [Context = context, RelativePath = relativePath, Status = Status])
		        in
		            Result,
		    RepositoryCatalog = #table(type table [release = text, repository = text], {
		        {"7", "OL7/latest"},
		        {"7", "OL7/UEKR6"},
		        {"8", "OL8/baseos/latest"},
		        {"8", "OL8/appstream"},
		        {"8", "OL8/UEKR7"},
		        {"9", "OL9/baseos/latest"},
		        {"9", "OL9/appstream"},
		        {"9", "OL9/UEKR7"},
		        {"10", "OL10/baseos/latest"},
		        {"10", "OL10/appstream"},
		        {"10", "OL10/UEKR8"}
		    }),
		    ActiveReleases = List.Buffer(List.Distinct(List.Transform(TargetRecords, each Text.Trim(Text.From([release_codename]))))),
		    ActiveRepositories = Table.ToRecords(Table.SelectRows(RepositoryCatalog, each List.Contains(ActiveReleases, [release]))),
		    ParseRepository = (release as text, repository as text) as list =>
		        let
		            BasePath = "repo/OracleLinux/" & repository & "/x86_64/",
		            RepomdDocument = Xml.Document(FetchOracleBinary(BasePath & "repodata/repomd.xml", repository & " repomd")),
		            RepomdNode = FirstNamedNode(RepomdDocument, "repomd"),
		            DataNodes = NamedNodes(NodeChildren(RepomdNode), "data"),
		            UpdateInfoDataNode = List.First(List.Select(DataNodes, each Text.Lower(NodeAttribute(_, "type")) = "updateinfo"), null),
		            LocationNode = FirstNamedNode(NodeChildren(UpdateInfoDataNode), "location"),
		            UpdateInfoHref = NodeAttribute(LocationNode, "href"),
		            ValidUpdateInfoHref = if UpdateInfoHref = "" then error Error.Record("OracleLinuxUpdateInfoMissing", "Oracle Public Yum repository metadata does not expose updateinfo.xml.", [Repository = repository]) else UpdateInfoHref,
		            UpdateInfoBinary = Binary.Decompress(FetchOracleBinary(BasePath & ValidUpdateInfoHref, repository & " updateinfo", null), Compression.GZip),
		            UpdateInfoDocument = Xml.Document(UpdateInfoBinary),
		            UpdatesNode = FirstNamedNode(UpdateInfoDocument, "updates"),
		            UpdateNodes = NamedNodes(NodeChildren(UpdatesNode), "update"),
		            SecurityUpdateNodes = List.Select(UpdateNodes, each Text.Lower(NodeAttribute(_, "type")) = "security" and Text.StartsWith(Text.Upper(ElementText(_, "id")), "ELSA-")),
		            Rows = List.Combine(List.Transform(SecurityUpdateNodes, (updateNode as record) =>
		                let
		                    AdvisoryId = Text.Upper(ElementText(updateNode, "id")),
		                    SeverityText = ElementText(updateNode, "severity"),
		                    Severity = if SeverityText = "" then "Unknown" else Text.Proper(Text.Lower(SeverityText)),
		                    ProductText = ElementText(updateNode, "release"),
		                    Product = if ProductText = "" then "Oracle Linux " & release else ProductText,
		                    IssuedNode = FirstNamedNode(NodeChildren(updateNode), "issued"),
		                    Published = try DateTime.FromText(NodeAttribute(IssuedNode, "date"), [Culture = "en-US"]) otherwise null,
		                    ReferencesNode = FirstNamedNode(NodeChildren(updateNode), "references"),
		                    ReferenceNodes = NamedNodes(NodeChildren(ReferencesNode), "reference"),
		                    CveIds = List.Distinct(List.RemoveNulls(List.Transform(List.Select(ReferenceNodes, each Text.Lower(NodeAttribute(_, "type")) = "cve"), each let CveId = Text.Upper(NodeAttribute(_, "id")) in if Text.StartsWith(CveId, "CVE-") then CveId else null))),
		                    SelfReference = List.First(List.Select(ReferenceNodes, each Text.Lower(NodeAttribute(_, "type")) = "self"), null),
		                    SelfHref = NodeAttribute(SelfReference, "href"),
		                    SourceUrl = if SelfHref <> "" then SelfHref else "https://linux.oracle.com/errata/" & AdvisoryId & ".html",
		                    PackageListNode = FirstNamedNode(NodeChildren(updateNode), "pkglist"),
		                    CollectionNodes = NamedNodes(NodeChildren(PackageListNode), "collection"),
		                    PackageNodes = List.Combine(List.Transform(CollectionNodes, each NamedNodes(NodeChildren(_), "package"))),
		                    MatchingPackages = List.RemoveNulls(List.Transform(PackageNodes, (packageNode as record) =>
		                        let
		                            PackageName = Text.Lower(NodeAttribute(packageNode, "name")),
		                            Version = NodeAttribute(packageNode, "version"),
		                            PackageRelease = NodeAttribute(packageNode, "release"),
		                            Epoch = NodeAttribute(packageNode, "epoch"),
		                            Architecture = Text.Lower(NodeAttribute(packageNode, "arch")),
		                            FixedVersion = (if Epoch = "" or Epoch = "0" then "" else Epoch & ":") & Version & "-" & PackageRelease,
		                            TargetKey = release & "|" & PackageName & "|" & NormalizeRpmVersion(FixedVersion)
		                        in
		                            if PackageName <> "" and Version <> "" and PackageRelease <> "" and Architecture <> "src" and Record.HasFields(TargetVersionsByKey, TargetKey) then [package_name = PackageName, package_versions = Record.Field(TargetVersionsByKey, TargetKey)] else null)),
		                    AdvisoryRows = List.Combine(List.Transform(MatchingPackages, (package as record) => List.Combine(List.Transform(package[package_versions], (targetVersion as text) => List.Transform(CveIds, (cveId as text) => [distribution = "Oracle Linux", release_codename = release, package_name = Text.From(package[package_name]), package_version = targetVersion, advisory_id = AdvisoryId, cve_id = cveId, severity = Severity, product = Product, published_at = Published, mapping_source = "Oracle Linux Updateinfo", source_url = SourceUrl])))))
		                in
		                    AdvisoryRows))
		        in
		            Rows,
		    OracleRows = if List.IsEmpty(TargetRecords) then {} else List.Combine(List.Transform(ActiveRepositories, each ParseRepository(Text.From([release]), Text.From([repository]))))
		in
		    OracleRows
	lineageTag: 668288b3-748c-418d-a399-4d817cba5e25

/// Returns exact AlmaLinux ALSA/CVE mappings from official AlmaLinux full errata feeds for missing package targets.
expression fnAlmaLinuxPatchCveRows =
		(missingPatches as table) as list =>
		let
		    SupportedReleases = {"10", "9", "8"},
		    RetryableStatusCodes = {429, 500, 502, 503, 504},
		    RpmArchitectures = {"x86_64", "aarch64", "ppc64le", "s390x", "noarch", "i686"},
		    NormalizeRpmVersion = (value as any) as text =>
		        let
		            Version = Text.Trim(Text.From(value)),
		            WithoutArchitecture = List.Accumulate(RpmArchitectures, Version, (state as text, architecture as text) => if Text.EndsWith(Text.Lower(state), "." & architecture) then Text.Start(state, Text.Length(state) - Text.Length(architecture) - 1) else state)
		        in
		            if Text.StartsWith(WithoutArchitecture, "0:") then Text.AfterDelimiter(WithoutArchitecture, ":") else WithoutArchitecture,
		    RelevantRows = Table.Buffer(Table.SelectRows(missingPatches, each Text.Lower(Text.Trim(Text.From([os_type]))) = "linux" and [os_distribution] = "AlmaLinux" and List.Contains(SupportedReleases, Text.Trim(Text.From([release_codename]))) and [patch_name] <> null and Text.Trim(Text.From([patch_name])) <> "" and [package_version] <> null and Text.Trim(Text.From([package_version])) <> "")),
		    TargetRecords = List.Buffer(Table.ToRecords(RelevantRows)),
		    MakeTargetKey = (target as record) as text => Text.Trim(Text.From(target[release_codename])) & "|" & Text.Lower(Text.Trim(Text.From(target[patch_name]))) & "|" & NormalizeRpmVersion(target[package_version]),
		    TargetKeys = List.Buffer(List.Distinct(List.Transform(TargetRecords, each MakeTargetKey(_)))),
		    TargetVersionsByKey = if List.IsEmpty(TargetKeys) then [] else Record.FromList(List.Transform(TargetKeys, (targetKey as text) => List.Distinct(List.Transform(List.Select(TargetRecords, each MakeTargetKey(_) = targetKey), each Text.Trim(Text.From([package_version]))))), TargetKeys),
		    FetchAlmaLinuxFeed = (release as text, optional attempt as nullable number) as record =>
		        let
		            CurrentAttempt = if attempt = null then 0 else attempt,
		            Response = try Web.Contents("https://errata.almalinux.org", [RelativePath = release & "/errata.full.json", Headers = [Accept = "application/json"], ManualStatusHandling = RetryableStatusCodes]) otherwise null,
		            Status = if Response = null then 0 else Record.FieldOrDefault(Value.Metadata(Response), "Response.Status", 200),
		            Result = if Status = 200 then Json.Document(Response) else if CurrentAttempt < 3 then Function.InvokeAfter(() => @FetchAlmaLinuxFeed(release, CurrentAttempt + 1), #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))) else error Error.Record("AlmaLinuxSecurityFeedUnavailable", "The AlmaLinux full errata feed could not be retrieved after four attempts.", [Release = release, Status = Status])
		        in
		            Result,
		    ActiveReleases = List.Buffer(List.Distinct(List.Transform(TargetRecords, each Text.Trim(Text.From([release_codename]))))),
		    ParseRelease = (release as text) as list =>
		        let
		            Feed = FetchAlmaLinuxFeed(release),
		            Advisories = Record.FieldOrDefault(Feed, "data", {}),
		            SecurityAdvisories = List.Select(Advisories, each Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(_, "type", "")))) = "security" and Text.StartsWith(Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(_, "id", "")))), "ALSA-")),
		            Rows = List.Combine(List.Transform(SecurityAdvisories, (advisory as record) =>
		                let
		                    AdvisoryId = Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(advisory, "id", "")))),
		                    SeverityText = Text.Trim(Text.From(Record.FieldOrDefault(advisory, "severity", "Unknown"))),
		                    Severity = if SeverityText = "" then "Unknown" else Text.Proper(Text.Lower(SeverityText)),
		                    IssuedSeconds = try Number.From(Record.FieldOrDefault(advisory, "issued_date", null)) otherwise null,
		                    Published = if IssuedSeconds = null then null else #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, IssuedSeconds),
		                    References = Record.FieldOrDefault(advisory, "references", {}),
		                    CveIds = List.Distinct(List.RemoveNulls(List.Transform(List.Select(References, each Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(_, "type", "")))) = "cve"), each let CveId = Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(_, "id", "")))) in if Text.StartsWith(CveId, "CVE-") then CveId else null))),
		                    Packages = Record.FieldOrDefault(advisory, "packages", {}),
		                    MatchingPackages = List.RemoveNulls(List.Transform(Packages, (package as record) =>
		                        let
		                            PackageName = Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(package, "name", "")))),
		                            Epoch = Text.Trim(Text.From(Record.FieldOrDefault(package, "epoch", "0"))),
		                            Version = Text.Trim(Text.From(Record.FieldOrDefault(package, "version", ""))),
		                            PackageRelease = Text.Trim(Text.From(Record.FieldOrDefault(package, "release", ""))),
		                            Architecture = Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(package, "arch", "")))),
		                            FixedVersion = (if Epoch = "" or Epoch = "0" then "" else Epoch & ":") & Version & "-" & PackageRelease,
		                            TargetKey = release & "|" & PackageName & "|" & NormalizeRpmVersion(FixedVersion)
		                        in
		                            if PackageName <> "" and Version <> "" and PackageRelease <> "" and Architecture <> "src" and Record.HasFields(TargetVersionsByKey, TargetKey) then [package_name = PackageName, package_versions = Record.Field(TargetVersionsByKey, TargetKey)] else null)),
		                    SourceUrl = "https://errata.almalinux.org/" & release & "/" & Text.Replace(AdvisoryId, ":", "-") & ".html",
		                    AdvisoryRows = List.Combine(List.Transform(MatchingPackages, (package as record) => List.Combine(List.Transform(package[package_versions], (targetVersion as text) => List.Transform(CveIds, (cveId as text) => [distribution = "AlmaLinux", release_codename = release, package_name = Text.From(package[package_name]), package_version = targetVersion, advisory_id = AdvisoryId, cve_id = cveId, severity = Severity, product = "AlmaLinux " & release, published_at = Published, mapping_source = "AlmaLinux Errata", source_url = SourceUrl])))))
		                in
		                    AdvisoryRows))
		        in
		            Rows,
		    AlmaLinuxRows = if List.IsEmpty(TargetRecords) then {} else List.Combine(List.Transform(ActiveReleases, each ParseRelease(_)))
		in
		    AlmaLinuxRows
	lineageTag: d42dad84-a102-40f0-a2ef-cf53681ea610

/// Returns exact Rocky Linux RLSA/CVE mappings from the official Rocky Apollo v2 errata API for missing package targets.
expression fnRockyLinuxPatchCveRows =
		(missingPatches as table) as list =>
		let
		    SupportedReleases = {"10", "9", "8"},
		    RetryableStatusCodes = {429, 500, 502, 503, 504},
		    RpmArchitectures = {"x86_64", "aarch64", "ppc64le", "s390x", "noarch", "i686", "src"},
		    NormalizeRpmVersion = (value as any) as text =>
		        let
		            Version = Text.Trim(Text.From(value)),
		            WithoutArchitecture = List.Accumulate(RpmArchitectures, Version, (state as text, architecture as text) => if Text.EndsWith(Text.Lower(state), "." & architecture) then Text.Start(state, Text.Length(state) - Text.Length(architecture) - 1) else state)
		        in
		            if Text.StartsWith(WithoutArchitecture, "0:") then Text.AfterDelimiter(WithoutArchitecture, ":") else WithoutArchitecture,
		    RelevantRows = Table.Buffer(Table.SelectRows(missingPatches, each Text.Lower(Text.Trim(Text.From([os_type]))) = "linux" and [os_distribution] = "Rocky Linux" and List.Contains(SupportedReleases, Text.Trim(Text.From([release_codename]))) and [patch_name] <> null and Text.Trim(Text.From([patch_name])) <> "" and [package_version] <> null and Text.Trim(Text.From([package_version])) <> "")),
		    TargetRecords = List.Buffer(Table.ToRecords(RelevantRows)),
		    MakeTargetKey = (target as record) as text => Text.Trim(Text.From(target[release_codename])) & "|" & Text.Lower(Text.Trim(Text.From(target[patch_name]))) & "|" & NormalizeRpmVersion(target[package_version]),
		    TargetKeys = List.Buffer(List.Distinct(List.Transform(TargetRecords, each MakeTargetKey(_)))),
		    TargetVersionsByKey = if List.IsEmpty(TargetKeys) then [] else Record.FromList(List.Transform(TargetKeys, (targetKey as text) => List.Distinct(List.Transform(List.Select(TargetRecords, each MakeTargetKey(_) = targetKey), each Text.Trim(Text.From([package_version]))))), TargetKeys),
		    FetchRockyPage = (product as text, page as number, optional attempt as nullable number) as record =>
		        let
		            CurrentAttempt = if attempt = null then 0 else attempt,
		            Response = try Web.Contents("https://errata.rockylinux.org", [RelativePath = "api/v2/advisories", Query = [limit = "100", page = Number.ToText(page), #"filters.product" = product, #"filters.type" = "TYPE_SECURITY", #"filters.include_rpms" = "true"], Headers = [Accept = "application/json"], ManualStatusHandling = RetryableStatusCodes]) otherwise null,
		            Status = if Response = null then 0 else Record.FieldOrDefault(Value.Metadata(Response), "Response.Status", 200),
		            Result = if Status = 200 then Json.Document(Response) else if CurrentAttempt < 3 then Function.InvokeAfter(() => @FetchRockyPage(product, page, CurrentAttempt + 1), #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))) else error Error.Record("RockyLinuxSecurityFeedUnavailable", "The Rocky Linux Apollo errata API could not be retrieved after four attempts.", [Product = product, Page = page, Status = Status])
		        in
		            Result,
		    ActiveReleases = List.Buffer(List.Distinct(List.Transform(TargetRecords, each Text.Trim(Text.From([release_codename]))))),
		    FetchReleaseAdvisories = (release as text) as list =>
		        let
		            Product = "Rocky Linux " & release,
		            FirstPage = FetchRockyPage(Product, 0),
		            Total = try Number.From(Record.FieldOrDefault(FirstPage, "total", 0)) otherwise 0,
		            PageSize = try Number.From(Record.FieldOrDefault(FirstPage, "size", 100)) otherwise 100,
		            PageCount = if Total = 0 or PageSize = 0 then 0 else Number.RoundUp(Total / PageSize),
		            Pages = if PageCount = 0 then {} else {0..PageCount - 1},
		            PageRecords = List.Transform(Pages, each if _ = 0 then FirstPage else FetchRockyPage(Product, _)),
		            Advisories = List.Combine(List.Transform(PageRecords, each Record.FieldOrDefault(_, "advisories", {})))
		        in
		            Advisories,
		    ParseRelease = (release as text) as list =>
		        let
		            Product = "Rocky Linux " & release,
		            Advisories = FetchReleaseAdvisories(release),
		            SecurityAdvisories = List.Select(Advisories, each Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(_, "type", "")))) = "TYPE_SECURITY" and Text.StartsWith(Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(_, "name", "")))), "RLSA-")),
		            Rows = List.Combine(List.Transform(SecurityAdvisories, (advisory as record) =>
		                let
		                    AdvisoryId = Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(advisory, "name", "")))),
		                    SeverityText = Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(advisory, "severity", "")))),
		                    Severity = if Text.StartsWith(SeverityText, "SEVERITY_") then Text.Proper(Text.Lower(Text.AfterDelimiter(SeverityText, "_"))) else if SeverityText = "" then "Unknown" else Text.Proper(Text.Lower(SeverityText)),
		                    PublishedText = Text.Trim(Text.From(Record.FieldOrDefault(advisory, "publishedAt", ""))),
		                    Published = if PublishedText = "" then null else try DateTimeZone.RemoveZone(DateTimeZone.FromText(PublishedText)) otherwise null,
		                    Cves = Record.FieldOrDefault(advisory, "cves", {}),
		                    CveIds = List.Distinct(List.RemoveNulls(List.Transform(Cves, each let CveId = Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(_, "name", "")))) in if Text.StartsWith(CveId, "CVE-") then CveId else null))),
		                    RpmMap = Record.FieldOrDefault(advisory, "rpms", []),
		                    ProductRpmRecord = if Record.HasFields(RpmMap, Product) then Record.Field(RpmMap, Product) else [],
		                    Nvras = Record.FieldOrDefault(ProductRpmRecord, "nvras", {}),
		                    MatchingPackages = List.RemoveNulls(List.Transform(Nvras, (nvraValue as any) =>
		                        let
		                            Nvra = Text.Trim(Text.From(nvraValue)),
		                            WithoutRpm = if Text.EndsWith(Text.Lower(Nvra), ".rpm") then Text.Start(Nvra, Text.Length(Nvra) - 4) else Nvra,
		                            Architecture = try List.First(List.Select(RpmArchitectures, each Text.EndsWith(Text.Lower(WithoutRpm), "." & _))) otherwise null,
		                            Nevr = if Architecture = null then WithoutRpm else Text.Start(WithoutRpm, Text.Length(WithoutRpm) - Text.Length(Architecture) - 1),
		                            BeforeEpoch = if Text.Contains(Nevr, ":") then Text.BeforeDelimiter(Nevr, ":") else "",
		                            PackageName = if BeforeEpoch = "" or not Text.Contains(BeforeEpoch, "-") then "" else Text.Lower(Text.BeforeDelimiter(BeforeEpoch, "-", {0, RelativePosition.FromEnd})),
		                            Epoch = if BeforeEpoch = "" or not Text.Contains(BeforeEpoch, "-") then "0" else Text.AfterDelimiter(BeforeEpoch, "-", {0, RelativePosition.FromEnd}),
		                            VersionRelease = if Text.Contains(Nevr, ":") then Text.AfterDelimiter(Nevr, ":") else "",
		                            FixedVersion = (if Epoch = "" or Epoch = "0" then "" else Epoch & ":") & VersionRelease,
		                            TargetKey = release & "|" & PackageName & "|" & NormalizeRpmVersion(FixedVersion)
		                        in
		                            if PackageName <> "" and VersionRelease <> "" and Architecture <> "src" and Record.HasFields(TargetVersionsByKey, TargetKey) then [package_name = PackageName, package_versions = Record.Field(TargetVersionsByKey, TargetKey)] else null)),
		                    SourceUrl = "https://errata.rockylinux.org/api/v2/advisories/" & AdvisoryId,
		                    AdvisoryRows = List.Combine(List.Transform(MatchingPackages, (package as record) => List.Combine(List.Transform(package[package_versions], (targetVersion as text) => List.Transform(CveIds, (cveId as text) => [distribution = "Rocky Linux", release_codename = release, package_name = Text.From(package[package_name]), package_version = targetVersion, advisory_id = AdvisoryId, cve_id = cveId, severity = Severity, product = Product, published_at = Published, mapping_source = "Rocky Linux Errata (Apollo)", source_url = SourceUrl])))))
		                in
		                    AdvisoryRows))
		        in
		            Rows,
		    RockyLinuxRows = if List.IsEmpty(TargetRecords) then {} else List.Combine(List.Transform(ActiveReleases, each ParseRelease(_)))
		in
		    RockyLinuxRows
	lineageTag: 017b75c7-9bb7-40cf-8807-febab03a05d0

/// Returns Canonical USN/CVE mappings when an Ubuntu security target supersedes the nearest vendor-published fixed binary package version under Debian version ordering.
expression fnUbuntuPatchCveRows =
		(missingPatches as table) as list =>
		let
		    SupportedReleases = {"noble", "jammy", "focal"},
		    RetryableStatusCodes = {429, 500, 502, 503, 504},
		    PageSize = 20,
		    CutoffDate = Date.AddMonths(Date.From(DateTimeZone.UtcNow()), -24),
		    IsDigit = (character as text) as logical => character >= "0" and character <= "9",
		    CharacterOrder = (character as text) as number =>
		        if character = "~" then -1
		        else if character = "" or IsDigit(character) then 0
		        else if (character >= "A" and character <= "Z") or (character >= "a" and character <= "z") then Character.ToNumber(character)
		        else Character.ToNumber(character) + 256,
		    CompareVersionPart = (leftValue as text, rightValue as text) as number =>
		        let
		            LeftLength = Text.Length(leftValue),
		            RightLength = Text.Length(rightValue),
		            CharacterAt = (value as text, index as number) as text => if index < Text.Length(value) then Text.Middle(value, index, 1) else "",
		            CompareNonDigits = (leftIndex as number, rightIndex as number) as record =>
		                let
		                    LeftCharacter = CharacterAt(leftValue, leftIndex),
		                    RightCharacter = CharacterAt(rightValue, rightIndex),
		                    LeftIsNonDigit = LeftCharacter <> "" and not IsDigit(LeftCharacter),
		                    RightIsNonDigit = RightCharacter <> "" and not IsDigit(RightCharacter),
		                    LeftOrder = CharacterOrder(LeftCharacter),
		                    RightOrder = CharacterOrder(RightCharacter),
		                    Result =
		                        if not LeftIsNonDigit and not RightIsNonDigit then [comparison = 0, leftIndex = leftIndex, rightIndex = rightIndex]
		                        else if LeftOrder < RightOrder then [comparison = -1, leftIndex = leftIndex, rightIndex = rightIndex]
		                        else if LeftOrder > RightOrder then [comparison = 1, leftIndex = leftIndex, rightIndex = rightIndex]
		                        else @CompareNonDigits(if LeftIsNonDigit then leftIndex + 1 else leftIndex, if RightIsNonDigit then rightIndex + 1 else rightIndex)
		                in
		                    Result,
		            ReadDigits = (value as text, startIndex as number) as record =>
		                let
		                    EndIndex = List.Accumulate({startIndex..Text.Length(value)}, startIndex, (state as number, candidate as number) => if state = candidate and candidate < Text.Length(value) and IsDigit(Text.Middle(value, candidate, 1)) then candidate + 1 else state),
		                    Digits = Text.Middle(value, startIndex, EndIndex - startIndex),
		                    Significant = Text.TrimStart(Digits, {"0"})
		                in
		                    [endIndex = EndIndex, significant = Significant],
		            CompareAt = (leftIndex as number, rightIndex as number) as number =>
		                let
		                    NonDigits = CompareNonDigits(leftIndex, rightIndex),
		                    NonDigitComparison = Number.From(NonDigits[comparison]),
		                    LeftDigits = if NonDigitComparison = 0 then ReadDigits(leftValue, Number.From(NonDigits[leftIndex])) else [endIndex = Number.From(NonDigits[leftIndex]), significant = ""],
		                    RightDigits = if NonDigitComparison = 0 then ReadDigits(rightValue, Number.From(NonDigits[rightIndex])) else [endIndex = Number.From(NonDigits[rightIndex]), significant = ""],
		                    LeftSignificant = Text.From(LeftDigits[significant]),
		                    RightSignificant = Text.From(RightDigits[significant]),
		                    DigitComparison =
		                        if NonDigitComparison <> 0 then NonDigitComparison
		                        else if Text.Length(LeftSignificant) < Text.Length(RightSignificant) then -1
		                        else if Text.Length(LeftSignificant) > Text.Length(RightSignificant) then 1
		                        else if LeftSignificant < RightSignificant then -1
		                        else if LeftSignificant > RightSignificant then 1
		                        else 0,
		                    NextLeftIndex = Number.From(LeftDigits[endIndex]),
		                    NextRightIndex = Number.From(RightDigits[endIndex]),
		                    Result = if DigitComparison <> 0 then DigitComparison else if NextLeftIndex >= LeftLength and NextRightIndex >= RightLength then 0 else @CompareAt(NextLeftIndex, NextRightIndex)
		                in
		                    Result
		        in
		            CompareAt(0, 0),
		    ParseDebianVersion = (value as any) as record =>
		        let
		            Version = Text.Trim(Text.From(value)),
		            ColonPosition = Text.PositionOf(Version, ":"),
		            PotentialEpoch = if ColonPosition > 0 then Text.Start(Version, ColonPosition) else "",
		            HasEpoch = PotentialEpoch <> "" and Text.Select(PotentialEpoch, {"0".."9"}) = PotentialEpoch,
		            Epoch = if HasEpoch then Number.FromText(PotentialEpoch) else 0,
		            WithoutEpoch = if HasEpoch then Text.Range(Version, ColonPosition + 1) else Version,
		            RevisionPosition = Text.PositionOf(WithoutEpoch, "-", Occurrence.Last),
		            Upstream = if RevisionPosition < 0 then WithoutEpoch else Text.Start(WithoutEpoch, RevisionPosition),
		            Revision = if RevisionPosition < 0 then "0" else Text.Range(WithoutEpoch, RevisionPosition + 1)
		        in
		            [epoch = Epoch, upstream = Upstream, revision = Revision],
		    CompareDebianVersions = (leftValue as any, rightValue as any) as number =>
		        let
		            Left = ParseDebianVersion(leftValue),
		            Right = ParseDebianVersion(rightValue),
		            EpochComparison = if Left[epoch] < Right[epoch] then -1 else if Left[epoch] > Right[epoch] then 1 else 0,
		            UpstreamComparison = if EpochComparison = 0 then CompareVersionPart(Text.From(Left[upstream]), Text.From(Right[upstream])) else EpochComparison,
		            RevisionComparison = if EpochComparison = 0 and UpstreamComparison = 0 then CompareVersionPart(Text.From(Left[revision]), Text.From(Right[revision])) else UpstreamComparison
		        in
		            RevisionComparison,
		    RelevantRows = Table.Buffer(Table.SelectRows(missingPatches, each Text.Lower(Text.Trim(Text.From([os_type]))) = "linux" and [os_distribution] = "Ubuntu" and Text.Contains(Text.Lower(Text.Trim(Text.From([classification]))), "security") and List.Contains(SupportedReleases, Text.Lower(Text.Trim(Text.From([release_codename])))) and [patch_name] <> null and Text.Trim(Text.From([patch_name])) <> "" and [package_version] <> null and Text.Trim(Text.From([package_version])) <> "")),
		    TargetRecords = List.Buffer(Table.ToRecords(RelevantRows)),
		    ActiveReleases = List.Buffer(List.Distinct(List.Transform(TargetRecords, each Text.Lower(Text.Trim(Text.From([release_codename])))))),
		    FetchPage = (release as text, offset as number, optional attempt as nullable number) as record =>
		        let
		            CurrentAttempt = if attempt = null then 0 else attempt,
		            Response = try Web.Contents("https://ubuntu.com", [RelativePath = "security/notices.json", Query = [limit = Text.From(PageSize), offset = Text.From(offset), order = "newest", release = release], Headers = [Accept = "application/json"], ManualStatusHandling = RetryableStatusCodes]) otherwise null,
		            Status = if Response = null then 0 else Record.FieldOrDefault(Value.Metadata(Response), "Response.Status", 200),
		            Result = if Status = 200 then Json.Document(Response) else if CurrentAttempt < 3 then Function.InvokeAfter(() => @FetchPage(release, offset, CurrentAttempt + 1), #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))) else error Error.Record("CanonicalSecurityFeedUnavailable", "Canonical Ubuntu Security Notices could not be retrieved after four attempts.", [Release = release, Offset = offset, Status = Status])
		        in
		            Result,
		    GetRecentNotices = (release as text) as list =>
		        let
		            Pages = List.Generate(
		                () => [Offset = 0, Payload = FetchPage(release, 0)],
		                each [Payload] <> null,
		                each
		                    let
		                        Notices = Record.FieldOrDefault([Payload], "notices", {}),
		                        PublishedDates = List.RemoveNulls(List.Transform(Notices, each try Date.From(DateTimeZone.FromText(Text.From(_[published]))) otherwise try Date.From(DateTime.FromText(Text.From(_[published]))) otherwise null)),
		                        OldestPublished = if List.IsEmpty(PublishedDates) then #date(1900, 1, 1) else List.Min(PublishedDates),
		                        NextOffset = [Offset] + PageSize,
		                        NextPayload = if List.Count(Notices) = PageSize and OldestPublished >= CutoffDate then FetchPage(release, NextOffset) else null
		                    in
		                        [Offset = NextOffset, Payload = NextPayload],
		                each Record.FieldOrDefault([Payload], "notices", {})
		            ),
		            Notices = List.Combine(Pages),
		            Recent = List.Select(Notices, each let Published = try Date.From(DateTimeZone.FromText(Text.From(_[published]))) otherwise try Date.From(DateTime.FromText(Text.From(_[published]))) otherwise null in Published <> null and Published >= CutoffDate)
		        in
		            Recent,
		    ParseRelease = (release as text) as list =>
		        let
		            ReleaseTargets = List.Buffer(List.Select(TargetRecords, each Text.Lower(Text.Trim(Text.From([release_codename]))) = release)),
		            Notices = GetRecentNotices(release),
		            PackageEvidence = List.Combine(List.Transform(Notices, (notice as record) =>
		                let
		                    AdvisoryId = Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(notice, "id", "")))),
		                    Product = Text.Trim(Text.From(Record.FieldOrDefault(notice, "title", ""))),
		                    PublishedText = Text.Trim(Text.From(Record.FieldOrDefault(notice, "published", ""))),
		                    Published = if PublishedText = "" then null else try DateTime.From(DateTimeZone.FromText(PublishedText)) otherwise try DateTime.FromText(PublishedText) otherwise null,
		                    CveIds = List.Distinct(List.RemoveNulls(List.Transform(Record.FieldOrDefault(notice, "cves_ids", {}), each let CveId = Text.Upper(Text.Trim(Text.From(_))) in if Text.StartsWith(CveId, "CVE-") then CveId else null))),
		                    ReleasePackages = Record.FieldOrDefault(notice, "release_packages", []),
		                    Packages = if ReleasePackages is record and Record.HasFields(ReleasePackages, release) then Record.Field(ReleasePackages, release) else {},
		                    BinaryPackages = List.Select(Packages, each try Record.FieldOrDefault(_, "is_source", true) = false otherwise false)
		                in
		                    List.RemoveNulls(List.Transform(BinaryPackages, (package as record) =>
		                        let
		                            PackageName = Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(package, "name", "")))),
		                            FixedVersion = Text.Trim(Text.From(Record.FieldOrDefault(package, "version", "")))
		                        in
		                            if PackageName = "" or FixedVersion = "" or List.IsEmpty(CveIds) then null else [package_name = PackageName, fixed_version = FixedVersion, advisory_id = AdvisoryId, cve_ids = CveIds, product = Product, published_at = Published, source_url = "https://ubuntu.com/security/notices/" & AdvisoryId])))),
		            Rows = List.Combine(List.Transform(ReleaseTargets, (target as record) =>
		                let
		                    PackageName = Text.Lower(Text.Trim(Text.From(target[patch_name]))),
		                    TargetVersion = Text.Trim(Text.From(target[package_version])),
		                    HasExactVersion = List.AnyTrue(List.Transform(PackageEvidence, each [package_name] = PackageName and CompareDebianVersions(TargetVersion, [fixed_version]) = 0)),
		                    Candidates = if HasExactVersion then {} else List.Select(PackageEvidence, each [package_name] = PackageName and CompareDebianVersions(TargetVersion, [fixed_version]) > 0),
		                    LatestFixedVersion = List.Accumulate(Candidates, null, (state as any, candidate as record) => if state = null then candidate[fixed_version] else if CompareDebianVersions(candidate[fixed_version], state) > 0 then candidate[fixed_version] else state),
		                    LatestEvidence = if LatestFixedVersion = null then {} else List.Select(Candidates, each CompareDebianVersions([fixed_version], LatestFixedVersion) = 0),
		                    TargetRows = List.Combine(List.Transform(LatestEvidence, (evidence as record) => List.Transform(evidence[cve_ids], (cveId as text) => [distribution = "Ubuntu", release_codename = release, package_name = PackageName, package_version = TargetVersion, advisory_id = Text.From(evidence[advisory_id]), cve_id = cveId, severity = "Unknown", product = Text.From(evidence[product]), published_at = evidence[published_at], mapping_source = "Canonical USN (superseded)", source_url = Text.From(evidence[source_url])])))
		                in
		                    TargetRows))
		        in
		            Rows,
		    UbuntuRows = if List.IsEmpty(TargetRecords) then {} else List.Combine(List.Transform(ActiveReleases, each ParseRelease(_)))
		in
		    UbuntuRows
	lineageTag: 58b5504b-161a-4c13-828b-77dc027347d7

