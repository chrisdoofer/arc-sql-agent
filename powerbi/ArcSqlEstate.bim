              ")",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "kpi\\esu"
          },
          {
            "name": "arc_sql_database_critical_latency_hrs",
            "expression": "IF([arc_sql_database_total_latency_hrs] > 720, [arc_sql_database_total_latency_hrs], BLANK())",
            "displayFolder": "kpi\\sql databases",
            "annotations": [
