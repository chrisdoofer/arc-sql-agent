            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "kpi_defender_sql_count",
            "expression": [
              "",
              "",
              "CALCULATE (",
              "    COUNTROWS ( view_extension_deployments ),",
              "    KEEPFILTERS ( LOWER ( TRIM ( view_extension_deployments[sql_defender] ) ) in {\"arc\", \"azure\"} )",
              ")",
              ""
            ],
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "kpi_defender_sql_not_installed",
            "expression": [
              "",
              "CALCULATE (",
              "    COUNTROWS ( view_extension_deployments ),",
              "    KEEPFILTERS ( LOWER ( TRIM ( view_extension_deployments[sql_defender] ) ) = \"notdeployed\" )",
              ")",
              ""
            ],
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "kpi_defender_sql_pct",
            "expression": [
              "",
              "DIVIDE (",
              "    [kpi_defender_sql_count] ,",
              "    [kpi_defender_sql_count] + [kpi_defender_sql_not_installed]",
