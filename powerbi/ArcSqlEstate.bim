        "partitions": [
          {
            "name": "fact_resources",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "-- 1) Standardize and Group Sources",
                "VAR RawUnion = ",
                "    UNION (",
                "        SELECTCOLUMNS(ext_arc_servers,         \"id\", [resource_id], \"pid\", [parent_resource_id], \"name\", [resource_name], \"plat\", [platform], \"loc\", [location], \"sub\", [subscription_id], \"rg\", [resource_group], \"type\", [resource_type], \"kind\", \"Server\"),",
                "        SELECTCOLUMNS(ext_azure_servers,       \"id\", [resource_id], \"pid\", [parent_resource_id], \"name\", [resource_name], \"plat\", [platform], \"loc\", [location], \"sub\", [subscription_id], \"rg\", [resource_group], \"type\", [resource_type], \"kind\", \"Server\"),",
                "        SELECTCOLUMNS(ext_arc_sql_instances,   \"id\", [resource_id], \"pid\", [parent_resource_id], \"name\", [resource_name], \"plat\", [platform], \"loc\", [location], \"sub\", [subscription_id], \"rg\", [resource_group], \"type\", [resource_type], \"kind\", \"SQL Instance\"),",
                "        SELECTCOLUMNS(ext_azure_sql_instances, \"id\", [resource_id], \"pid\", [parent_resource_id], \"name\", [resource_name], \"plat\", [platform], \"loc\", [location], \"sub\", [subscription_id], \"rg\", [resource_group], \"type\", [resource_type], \"kind\", \"SQL Instance\"),",
                "        SELECTCOLUMNS(ext_arc_sql_databases,   \"id\", [resource_id], \"pid\", [parent_resource_id], \"name\", [resource_name], \"plat\", [platform], \"loc\", [location], \"sub\", [subscription_id], \"rg\", [resource_group], \"type\", [resource_type], \"kind\", \"SQL Database\"),",
                "        SELECTCOLUMNS(ext_all_extensions,      \"id\", [resource_id], \"pid\", [parent_resource_id], \"name\", [resource_name], \"plat\", [platform], \"loc\", [location], \"sub\", [subscription_id], \"rg\", [resource_group], \"type\", [resource_type], \"kind\", \"Extension\")",
                "    )",
                "",
                "-- 2) Filter Blanks",
                "VAR FilteredRows = FILTER(RawUnion, [id] <> BLANK() && [id] <> \"\")",
                "",
                "-- 3) Create Unique Key Map variable",
                "VAR UniqueIDs = DISTINCT(SELECTCOLUMNS(FilteredRows, \"resource_id\", [id]))",
                "VAR KeyMap = ",
                "    ADDCOLUMNS(",
                "        UniqueIDs,",
                "        \"key\", RANKX(UniqueIDs, [resource_id], , ASC, DENSE)",
                "    )",
                "",
                "-- 4) Enrichment using MAXX/FILTER (Standard workaround for Table Variables)",
                "VAR Enriched = ",
                "    ADDCOLUMNS(",
                "        FilteredRows,",
                "        \"resource_key\", ",
                "            VAR CurrentID = [id] ",
                "            RETURN MAXX(FILTER(KeyMap, [resource_id] = CurrentID), [key]),",
                "        \"parent_key\",   ",
                "            VAR CurrentPID = [pid] ",
                "            RETURN IF(ISBLANK(CurrentPID) || CurrentPID = \"\", BLANK(), ",
                "                   MAXX(FILTER(KeyMap, [resource_id] = CurrentPID), [key]))",
                "    )",
                "",
                "-- 5) Final Projection with Typed Keys",
                "RETURN",
                "SELECTCOLUMNS (",
                "    Enriched,",
                "    \"resource_key\",        INT( [resource_key] ),",
                "    \"parent_resource_key\", INT( [parent_key] ),",
                "    \"resource_id\",         [id],",
                "    \"parent_resource_id\",  [pid],",
                "    \"resource_name\",       [name],",
                "    \"resource_kind\",       [kind],",
                "    \"platform\",            [plat],",
                "    \"location\",            [loc],",
                "    \"subscription_id\",     [sub],",
                "    \"resource_group\",      [rg],",
                "    \"resource_type\",       [type]",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "6b9bee3d4e4a41aa8161b852ba5e4c47"
          }
        ]
      },
      {
        "name": "dim_tags",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "tag_key",
            "isNameInferred": true,
            "sourceColumn": "[tag_key]",
            "formatString": "0",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "tag_name",
            "isNameInferred": true,
            "sourceColumn": "[tag_name]",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "tag_value",
            "isNameInferred": true,
            "sourceColumn": "[tag_value]",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "dim_tags",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "-- 1. Get all unique combinations across the model",
                "VAR RawTags = ",
                "    DISTINCT ( ",
                "        SELECTCOLUMNS ( ",
                "            ext_resource_tags, ",
                "            \"name\",  TRIM ( ext_resource_tags[tag_name] ), ",
                "            \"value\", TRIM ( ext_resource_tags[tag_value] ) ",
                "        ) ",
                "    )",
                "",
                "-- 2. Filter out blanks/empty strings",
                "VAR FilteredTags = ",
                "    FILTER ( ",
                "        RawTags, ",
                "        [name] <> BLANK() && [name] <> \"\" && ",
                "        [value] <> BLANK() && [value] <> \"\" ",
                "    )",
                "",
                "-- 3. Generate the Integer Key",
                "VAR WithKey = ",
                "    ADDCOLUMNS (",
                "        FilteredTags,",
                "        \"tag_key\", RANKX ( FilteredTags, [name] & \"|\" & [value], , ASC, DENSE )",
                "    )",
                "",
                "RETURN ",
                "    SELECTCOLUMNS (",
                "        WithKey,",
                "        \"tag_key\",   INT ( [tag_key] ),",
                "        \"tag_name\",  [name],",
                "        \"tag_value\", [value]",
                "    )"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "4905306d58504476b3e0c6d6fd3b2afc"
          }
        ]
      },
      {
        "name": "view_arg_scope_validation",
        "description": "Resource Graph scope coverage for Arc machines and Arc-enabled SQL instances, grouped by subscription and resource type.",
        "lineageTag": "efc57732-4fb2-4276-93b3-d487d504d353",
        "columns": [
          {
            "name": "resource_type",
            "dataType": "string",
            "description": "Azure resource type included in scope validation.",
            "sourceColumn": "resource_type",
            "lineageTag": "af4ca4ce-4648-4996-9c27-bd97281b579b",
            "summarizeBy": "none"
          },
          {
            "name": "subscription_id",
            "dataType": "string",
            "description": "Azure subscription identifier returned by Resource Graph.",
            "sourceColumn": "subscription_id",
            "lineageTag": "a2e36d70-ebbd-40e4-9ce0-ec5997fcb2dc",
            "summarizeBy": "none"
          },
          {
            "name": "resource_count",
            "dataType": "int64",
            "description": "Number of resources visible for the subscription and resource type.",
            "isHidden": true,
            "sourceColumn": "resource_count",
            "lineageTag": "d3287fd1-3c91-479a-9e67-80908b35f386",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "view_arg_scope_validation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    SourceRaw = AzureResourceGraph.Query(",
                "        \"",
                "        resources",
                "        | where type =~ 'microsoft.hybridcompute/machines'",
                "            or type =~ 'microsoft.azurearcdata/sqlserverinstances'",
                "        | summarize resource_count = count() by resource_type = tolower(type), subscription_id = tolower(subscriptionId)",
                "        \",",
                "        null, null, null, [resultTruncated = false]",
                "    ),",
                "    Selected = Table.SelectColumns(SourceRaw, {\"resource_type\", \"subscription_id\", \"resource_count\"}, MissingField.UseNull),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"resource_type\", type text}, {\"subscription_id\", type text}, {\"resource_count\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
