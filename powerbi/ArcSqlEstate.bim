            "name": "kpi_change_tracking_windows_count",
            "expression": [
              "",
              "CALCULATE (",
              "    COUNTROWS ( view_extension_deployments ),",
              "    KEEPFILTERS (",
              "        LOWER ( TRIM ( view_extension_deployments[extension_change_tracking] ) ) = \"windows\"",
              "    )",
              ")",
