            "displayFolder": "kpi\\sql databases",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "sql_database_type_system",
            "expression": [
