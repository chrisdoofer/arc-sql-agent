            "name": "resource_key",
            "dataType": "int64",
            "description": "Model relationship key resolved from the affected machine resource identifier.",
            "isHidden": true,
            "expression": "LOOKUPVALUE(fact_keys[resource_key], fact_keys[resource_id], [machine_resource_id])",
            "lineageTag": "531d6939-d4b2-4ff4-acef-cf43dc2c01d3",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "view_missing_patches",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    SourceRaw = AzureResourceGraph.Query(",
                "        \"",
                "        patchassessmentresources",
                "        | where type has 'softwarepatches'",
                "        | extend prop = parse_json(properties)",
                "        | extend machine_resource_id = tolower(tostring(split(id, '/patchAssessmentResults/')[0]))",
                "        | join kind=leftouter (",
                "            patchassessmentresources",
                "            | where type !has 'softwarepatches'",
                "            | extend sprop = parse_json(properties)",
                "            | project",
                "                machine_resource_id = tolower(tostring(split(id, '/patchAssessmentResults/')[0])),",
                "                os_type = tostring(sprop.osType),",
                "                patch_service_used = tostring(sprop.patchServiceUsed),",
                "                patch_os_version = tostring(sprop.osVersion)",
                "        ) on machine_resource_id",
                "        | join kind=leftouter (",
                "            resources",
                "            | where type =~ 'microsoft.hybridcompute/machines'",
                "            | extend mprop = parse_json(properties)",
                "            | project",
                "                machine_resource_id = tolower(id),",
                "                machine_os_sku = tostring(mprop.osSku),",
                "                machine_os_version = tostring(mprop.osVersion)",
                "        ) on machine_resource_id",
                "        | extend machine_os_sku_normalized = tolower(machine_os_sku)",
                "        | extend suse_version_text = tolower(strcat(machine_os_sku, ' ', machine_os_version, ' ', patch_os_version))",
                "        | extend os_distribution = case(",
                "            machine_os_sku_normalized contains 'ubuntu', 'Ubuntu',",
                "            machine_os_sku_normalized contains 'red hat' or machine_os_sku_normalized contains 'rhel', 'Red Hat Enterprise Linux',",
                "            machine_os_sku_normalized contains 'debian', 'Debian GNU/Linux',",
                "            machine_os_sku_normalized contains 'suse' or machine_os_sku_normalized contains 'sles', 'SUSE Linux Enterprise Server',",
                "            ''",
                "        )",
                "        | extend release_codename = case(",
                "            os_distribution == 'Ubuntu' and machine_os_sku contains '24.04', 'noble',",
                "            os_distribution == 'Ubuntu' and machine_os_sku contains '22.04', 'jammy',",
                "            os_distribution == 'Ubuntu' and machine_os_sku contains '20.04', 'focal',",
                "            os_distribution == 'Red Hat Enterprise Linux' and (machine_os_sku contains '10.' or machine_os_sku endswith ' 10'), '10',",
                "            os_distribution == 'Red Hat Enterprise Linux' and (machine_os_sku contains '9.' or machine_os_sku endswith ' 9'), '9',",
                "            os_distribution == 'Red Hat Enterprise Linux' and (machine_os_sku contains '8.' or machine_os_sku endswith ' 8'), '8',",
                "            os_distribution == 'Red Hat Enterprise Linux' and (machine_os_sku contains '7.' or machine_os_sku endswith ' 7'), '7',",
                "            os_distribution == 'Debian GNU/Linux' and (machine_os_sku_normalized contains 'trixie' or machine_os_sku contains '13.' or machine_os_sku endswith ' 13'), 'trixie',",
                "            os_distribution == 'Debian GNU/Linux' and (machine_os_sku_normalized contains 'bookworm' or machine_os_sku contains '12.' or machine_os_sku endswith ' 12'), 'bookworm',",
                "            os_distribution == 'Debian GNU/Linux' and (machine_os_sku_normalized contains 'bullseye' or machine_os_sku contains '11.' or machine_os_sku endswith ' 11'), 'bullseye',",
                "            os_distribution == 'SUSE Linux Enterprise Server' and (suse_version_text contains '15 sp7' or suse_version_text contains '15-sp7' or suse_version_text contains '15.7'), '15 SP7',",
                "            os_distribution == 'SUSE Linux Enterprise Server' and (suse_version_text contains '15 sp6' or suse_version_text contains '15-sp6' or suse_version_text contains '15.6'), '15 SP6',",
                "            os_distribution == 'SUSE Linux Enterprise Server' and (suse_version_text contains '15 sp5' or suse_version_text contains '15-sp5' or suse_version_text contains '15.5'), '15 SP5',",
                "            os_distribution == 'SUSE Linux Enterprise Server' and (suse_version_text contains '15 sp4' or suse_version_text contains '15-sp4' or suse_version_text contains '15.4'), '15 SP4',",
                "            os_distribution == 'SUSE Linux Enterprise Server' and (suse_version_text contains '15 sp3' or suse_version_text contains '15-sp3' or suse_version_text contains '15.3'), '15 SP3',",
                "            os_distribution == 'SUSE Linux Enterprise Server' and (suse_version_text contains '12 sp5' or suse_version_text contains '12-sp5' or suse_version_text contains '12.5'), '12 SP5',",
                "            os_distribution == 'SUSE Linux Enterprise Server' and (suse_version_text contains '12 sp4' or suse_version_text contains '12-sp4' or suse_version_text contains '12.4'), '12 SP4',",
                "            os_distribution == 'SUSE Linux Enterprise Server' and (suse_version_text contains '12 sp3' or suse_version_text contains '12-sp3' or suse_version_text contains '12.3'), '12 SP3',",
                "            ''",
                "        )",
                "        | project",
                "            machine_resource_id,",
                "            machine_name = tostring(split(machine_resource_id, '/')[8]),",
                "            patch_id = tostring(name),",
                "            patch_name = tostring(prop.patchName),",
                "            kb_id = tostring(prop.kbId),",
                "            classification = tostring(prop.classifications),",
                "            os_type,",
                "            patch_service_used,",
                "            os_distribution,",
                "            release_codename,",
                "            package_version = tostring(prop.version),",
                "            reboot_behavior = tostring(prop.rebootBehavior),",
                "            assessment_time = todatetime(prop.lastModifiedDateTime),",
                "            subscription_id = tolower(subscriptionId),",
                "            resource_group = tostring(resourceGroup),",
                "            tenant_id = tostring(tenantId)",
                "        \",",
                "        null, null, null, [resultTruncated = false]",
                "    ),",
                "    NormalizedClassifications = Table.TransformColumns(",
                "        SourceRaw,",
                "        {",
                "            {",
                "                \"classification\",",
                "                each",
                "                    if _ = null then",
                "                        null",
                "                    else",
                "                        let",
                "                            Parsed = try Json.Document(Text.ToBinary(_)) otherwise _,",
                "                            Values = if Parsed is list then Parsed else {Parsed}",
                "                        in",
                "                            Text.Combine(List.Transform(Values, each Text.From(_)), \", \"),",
                "                type text",
                "            }",
                "        }",
                "    ),",
                "    NormalizedKbIds = Table.TransformColumns(",
                "        NormalizedClassifications,",
                "        {",
                "            {",
                "                \"kb_id\",",
                "                each if _ = null then null else Text.Replace(Text.Upper(Text.Trim(Text.From(_))), \"KB\", \"\"),",
                "                type text",
                "            }",
                "        }",
                "    ),",
                "    Selected = Table.SelectColumns(NormalizedKbIds, {\"machine_resource_id\", \"machine_name\", \"patch_id\", \"patch_name\", \"kb_id\", \"classification\", \"os_type\", \"patch_service_used\", \"os_distribution\", \"release_codename\", \"package_version\", \"reboot_behavior\", \"assessment_time\", \"subscription_id\", \"resource_group\", \"tenant_id\"}, MissingField.UseNull),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"machine_resource_id\", type text}, {\"machine_name\", type text}, {\"patch_id\", type text}, {\"patch_name\", type text}, {\"kb_id\", type text}, {\"classification\", type text}, {\"os_type\", type text}, {\"patch_service_used\", type text}, {\"os_distribution\", type text}, {\"release_codename\", type text}, {\"package_version\", type text}, {\"reboot_behavior\", type text}, {\"assessment_time\", type datetime}, {\"subscription_id\", type text}, {\"resource_group\", type text}, {\"tenant_id\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_patch_cve_mapping",
        "description": "Authoritative Microsoft Security Response Center mapping from Knowledge Base updates to CVEs.",
        "isHidden": true,
        "columns": [
          {
            "name": "kb_numeric",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "kb_numeric",
            "summarizeBy": "none"
          },
          {
            "name": "cve_id",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "cve_id",
            "summarizeBy": "none"
          },
          {
            "name": "product",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "product",
            "summarizeBy": "none"
          },
          {
            "name": "severity",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "severity",
            "summarizeBy": "none"
          },
          {
            "name": "source_url",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "source_url",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_patch_cve_mapping",
            "mode": "import",
            "queryGroup": "Dimensions",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    UpdateIndexJson = Json.Document(Web.Contents(\"https://api.msrc.microsoft.com\", [RelativePath=\"cvrf/v3.0/updates\", Headers=[Accept=\"application/json\"]])),",
                "    UpdateRecords =",
                "        if UpdateIndexJson is record and Record.HasFields(UpdateIndexJson, \"value\")",
                "        then UpdateIndexJson[value]",
                "        else error \"MSRC update index did not return the expected value collection.\",",
                "    UpdateTable = Table.FromRecords(UpdateRecords),",
                "    TypedUpdates = Table.TransformColumnTypes(UpdateTable, {{\"ID\", type text}, {\"InitialReleaseDate\", type datetimezone}}),",
                "    RecentUpdates = Table.SelectRows(TypedUpdates, each Date.From([InitialReleaseDate]) >= Date.AddMonths(Date.From(DateTimeZone.UtcNow()), -18)),",
                "    LoadDocument = (documentId as text) as table =>",
                "        let",
                "            DocumentJson = Json.Document(Web.Contents(\"https://api.msrc.microsoft.com\", [RelativePath=\"cvrf/v3.0/cvrf/\" & documentId, Headers=[Accept=\"application/json\"]])),",
                "            Vulnerabilities =",
                "                if DocumentJson is record and Record.HasFields(DocumentJson, \"Vulnerability\")",
                "                then DocumentJson[Vulnerability]",
                "                else error \"MSRC document \" & documentId & \" did not return a Vulnerability collection.\",",
                "            VulnerabilityRows = List.Combine(List.Transform(Vulnerabilities, (v as record) =>",
                "                let",
                "                    CveId = try Text.From(v[CVE]) otherwise null,",
                "                    Product = try Text.From(v[Title][Value]) otherwise null,",
                "                    Threats = try v[Threats] otherwise {},",
                "                    SeverityThreat = List.First(List.Select(Threats, each try _[Type] = 3 otherwise false), null),",
                "                    Severity = if SeverityThreat is null then null else try Text.From(SeverityThreat[Description][Value]) otherwise null,",
                "                    Remediations = try v[Remediations] otherwise {},",
                "                    SecurityUpdates = List.Select(Remediations, each try _[Type] = 2 and Record.HasFields(_, \"Description\") otherwise false),",
                "                    Rows = List.Transform(SecurityUpdates, (r as record) =>",
                "                        let",
                "                            KbNumeric = try Text.Select(Text.From(r[Description][Value]), {\"0\"..\"9\"}) otherwise null",
                "                        in",
                "                            [kb_numeric=KbNumeric, cve_id=CveId, product=Product, severity=Severity, source_url=\"https://api.msrc.microsoft.com/cvrf/v3.0/cvrf/\" & documentId]",
                "                    )",
                "                in",
                "                    Rows",
                "            ))",
                "        in",
                "            if List.Count(VulnerabilityRows) = 0",
                "            then #table(type table [kb_numeric=text, cve_id=text, product=text, severity=text, source_url=text], {})",
                "            else Table.FromRecords(VulnerabilityRows),",
                "    MappingTables = List.Transform(RecentUpdates[ID], each LoadDocument(_)),",
                "    MappingRows = Table.Combine(MappingTables),",
                "    ValidMappings = Table.SelectRows(MappingRows, each [kb_numeric] <> null and [kb_numeric] <> \"\" and [cve_id] <> null and [cve_id] <> \"\"),",
                "    DistinctMappings = Table.Distinct(ValidMappings, {\"kb_numeric\", \"cve_id\"})",
                "in",
                "    DistinctMappings"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "dim_linux_patch_cve_mapping",
        "description": "Authoritative Linux package-to-CVE mappings normalized from Canonical, Red Hat, Debian, and SUSE security sources.",
        "isHidden": true,
        "columns": [
          {
            "name": "distribution",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "distribution",
            "summarizeBy": "none"
          },
          {
            "name": "release_codename",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "release_codename",
            "summarizeBy": "none"
          },
          {
            "name": "package_name",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "package_name",
            "summarizeBy": "none"
          },
          {
            "name": "package_version",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "package_version",
            "summarizeBy": "none"
          },
          {
            "name": "advisory_id",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "advisory_id",
            "summarizeBy": "none"
          },
          {
            "name": "cve_id",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "cve_id",
            "summarizeBy": "none"
          },
          {
            "name": "severity",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "severity",
            "summarizeBy": "none"
          },
          {
            "name": "product",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "product",
            "summarizeBy": "none"
          },
          {
            "name": "published_at",
            "dataType": "dateTime",
            "isHidden": true,
            "sourceColumn": "published_at",
            "formatString": "General Date"
          },
          {
            "name": "mapping_source",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "mapping_source",
            "summarizeBy": "none"
          },
          {
            "name": "source_url",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "source_url",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_linux_patch_cve_mapping",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    SupportedReleases = {\"noble\", \"jammy\", \"focal\"},",
                "    SupportedRhelReleases = {\"10\", \"9\", \"8\", \"7\"},",
                "    SupportedDebianReleases = {\"trixie\", \"bookworm\", \"bullseye\"},",
                "    SupportedSuseReleases = {\"15 SP7\", \"15 SP6\", \"15 SP5\", \"15 SP4\", \"15 SP3\", \"12 SP5\", \"12 SP4\", \"12 SP3\"},",
                "    RpmArchitectures = {\"x86_64\", \"aarch64\", \"ppc64le\", \"s390x\", \"noarch\", \"i686\"},",
                "    NormalizeRpmVersion = (value as any) as text =>",
                "        let",
                "            Version = Text.Trim(Text.From(value)),",
                "            WithoutArchitecture =",
                "                List.Accumulate(",
                "                    RpmArchitectures,",
                "                    Version,",
                "                    (state as text, architecture as text) =>",
                "                        if Text.EndsWith(Text.Lower(state), \".\" & architecture)",
                "                        then Text.Start(state, Text.Length(state) - Text.Length(architecture) - 1)",
                "                        else state",
                "                ),",
                "            Normalized = if Text.StartsWith(WithoutArchitecture, \"0:\") then Text.AfterDelimiter(WithoutArchitecture, \":\") else WithoutArchitecture",
                "        in",
                "            Normalized,",
                "    RelevantPatchRows =",
                "        Table.SelectRows(",
                "            view_missing_patches,",
                "            each",
                "                Text.Lower(Text.Trim(Text.From([os_type]))) = \"linux\"",
                "                    and List.Contains(",
                "                        SupportedReleases,",
                "                        Text.Lower(Text.Trim(Text.From([release_codename])))",
                "                    )",
                "                    and [patch_name] <> null",
                "                    and Text.Trim(Text.From([patch_name])) <> \"\"",
                "                    and [package_version] <> null",
                "                    and Text.Trim(Text.From([package_version])) <> \"\"",
                "        ),",
                "    RelevantPatchKeys =",
                "        List.Buffer(",
                "            List.Distinct(",
                "                List.Transform(",
                "                    Table.ToRecords(RelevantPatchRows),",
                "                    each",
                "                        Text.Lower(Text.Trim(Text.From([release_codename])))",
                "                            & \"|\"",
                "                            & Text.Lower(Text.Trim(Text.From([patch_name])))",
                "                            & \"|\"",
                "                            & Text.Trim(Text.From([package_version]))",
                "                )",
                "            )",
                "        ),",
                "    RelevantPatchKeySet =",
                "        Record.FromList(",
                "            List.Repeat({true}, List.Count(RelevantPatchKeys)),",
                "            RelevantPatchKeys",
                "        ),",
                "    PageSize = 20,",
                "    CutoffDate = Date.AddMonths(Date.From(DateTimeZone.UtcNow()), -24),",
                "    RetryableStatusCodes = {429, 500, 502, 503, 504},",
                "    FetchPage = (offset as number, optional attempt as nullable number) as record =>",
                "        let",
                "            CurrentAttempt = if attempt = null then 0 else attempt,",
                "            Response =",
                "                try",
                "                    Web.Contents(",
                "                        \"https://ubuntu.com\",",
                "                        [",
                "                            RelativePath = \"security/notices.json\",",
                "                            Query = [",
                "                                limit = Text.From(PageSize),",
                "                                offset = Text.From(offset),",
                "                                order = \"newest\"",
                "                            ],",
                "                            Headers = [Accept = \"application/json\"],",
                "                            ManualStatusHandling = RetryableStatusCodes",
                "                        ]",
                "                    )",
                "                otherwise",
                "                    null,",
                "            Status =",
                "                if Response = null",
                "                then 0",
                "                else Record.FieldOrDefault(Value.Metadata(Response), \"Response.Status\", 200),",
                "            Result =",
                "                if Status = 200 then",
                "                    Json.Document(Response)",
                "                else if CurrentAttempt < 3 then",
                "                    Function.InvokeAfter(",
                "                        () => @FetchPage(offset, CurrentAttempt + 1),",
                "                        #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))",
                "                    )",
                "                else",
                "                    error Error.Record(",
                "                        \"CanonicalSecurityFeedUnavailable\",",
                "                        \"Canonical Ubuntu Security Notices could not be retrieved after four attempts.\",",
                "                        [Offset = offset, Status = Status]",
                "                    )",
                "        in",
                "            Result,",
                "    GetRecentNotices = () as list =>",
                "        let",
                "            Pages =",
                "                List.Generate(",
                "                    () => [Offset = 0, Payload = FetchPage(0)],",
                "                    each [Payload] <> null,",
                "                    each",
                "                        let",
                "                            Notices = Record.FieldOrDefault([Payload], \"notices\", {}),",
                "                            PublishedDates =",
                "                                List.RemoveNulls(",
                "                                    List.Transform(",
                "                                        Notices,",
                "                                        each try Date.From(DateTimeZone.FromText(Text.From(_[published]))) otherwise null",
                "                                    )",
                "                                ),",
                "                            OldestPublished =",
                "                                if List.IsEmpty(PublishedDates)",
                "                                then #date(1900, 1, 1)",
                "                                else List.Min(PublishedDates),",
                "                            NextOffset = [Offset] + PageSize,",
                "                            NextPayload =",
                "                                if List.Count(Notices) = PageSize and OldestPublished >= CutoffDate",
                "                                then FetchPage(NextOffset)",
                "                                else null",
                "                        in",
                "                            [Offset = NextOffset, Payload = NextPayload],",
                "                    each Record.FieldOrDefault([Payload], \"notices\", {})",
                "                ),",
                "            Notices = List.Combine(Pages),",
                "            Recent =",
                "                List.Select(",
                "                    Notices,",
                "                    each",
                "                        let",
                "                            Published = try Date.From(DateTimeZone.FromText(Text.From(_[published]))) otherwise null",
                "                        in",
                "                            Published <> null and Published >= CutoffDate",
                "                )",
                "        in",
                "            Recent,",
                "    RecentNotices =",
                "        if List.IsEmpty(RelevantPatchKeys)",
                "        then {}",
                "        else List.Buffer(GetRecentNotices()),",
                "    MappingRows =",
                "        List.Combine(",
                "            List.Transform(",
                "                SupportedReleases,",
                "                (release as text) =>",
                "                    List.Combine(",
                "                        List.Transform(",
                "                            RecentNotices,",
                "                            (notice as record) =>",
                "                                let",
                "                                    AdvisoryId = Text.From(Record.FieldOrDefault(notice, \"id\", \"\")),",
                "                                    Product = Text.From(Record.FieldOrDefault(notice, \"title\", \"\")),",
                "                                    Published =",
                "                                        try DateTime.From(DateTimeZone.FromText(Text.From(notice[published])))",
                "                                        otherwise null,",
                "                                    CveIds = Record.FieldOrDefault(notice, \"cves_ids\", {}),",
                "                                    ReleasePackages = Record.FieldOrDefault(notice, \"release_packages\", []),",
                "                                    Packages =",
                "                                        if Record.HasFields(ReleasePackages, release)",
                "                                        then Record.Field(ReleasePackages, release)",
                "                                        else {},",
                "                                    BinaryPackages =",
                "                                        List.Select(",
                "                                            Packages,",
                "                                            each",
                "                                                try",
                "                                                    Record.FieldOrDefault(_, \"is_source\", true) = false",
                "                                                        and Record.HasFields(",
                "                                                            RelevantPatchKeySet,",
                "                                                            release",
                "                                                                & \"|\"",
                "                                                                & Text.Lower(Text.Trim(Text.From(_[name])))",
                "                                                                & \"|\"",
                "                                                                & Text.Trim(Text.From(_[version]))",
                "                                                        )",
                "                                                otherwise",
                "                                                    false",
                "                                        )",
                "                                in",
                "                                    List.Combine(",
                "                                        List.Transform(",
                "                                            BinaryPackages,",
                "                                            (package as record) =>",
                "                                                List.Transform(",
                "                                                    CveIds,",
                "                                                    (cve as text) => [",
                "                                                        distribution = \"Ubuntu\",",
                "                                                        release_codename = release,",
                "                                                        package_name = Text.Lower(Text.Trim(Text.From(package[name]))),",
                "                                                        package_version = Text.Trim(Text.From(package[version])),",
                "                                                        advisory_id = AdvisoryId,",
                "                                                        cve_id = Text.Upper(Text.Trim(cve)),",
                "                                                        severity = \"Unknown\",",
                "                                                        product = Product,",
                "                                                        published_at = Published,",
                "                                                        mapping_source = \"Canonical USN\",",
                "                                                        source_url = \"https://ubuntu.com/security/notices/\" & AdvisoryId",
                "                                                    ]",
                "                                                )",
                "                                        )",
                "                                    )",
                "                        )",
                "                    )",
                "            )",
                "        ),",
                "    RhelRelevantRows =",
                "        Table.Buffer(",
                "            Table.SelectRows(",
                "                view_missing_patches,",
                "                each",
                "                    Text.Lower(Text.Trim(Text.From([os_type]))) = \"linux\"",
                "                        and [os_distribution] = \"Red Hat Enterprise Linux\"",
                "                        and List.Contains(SupportedRhelReleases, Text.Trim(Text.From([release_codename])))",
                "                        and [patch_name] <> null",
                "                        and Text.Trim(Text.From([patch_name])) <> \"\"",
                "                        and [package_version] <> null",
                "                        and Text.Trim(Text.From([package_version])) <> \"\"",
                "            )",
                "        ),",
                "    RhelPackages =",
                "        List.Buffer(",
                "            List.Distinct(",
                "                List.Transform(",
                "                    Table.Column(RhelRelevantRows, \"patch_name\"),",
                "                    each Text.Lower(Text.Trim(Text.From(_)))",
                "                )",
                "            )",
                "        ),",
                "    RedHatPageSize = 1000,",
                "    FetchRedHatPage = (packageName as text, page as number, optional attempt as nullable number) as list =>",
                "        let",
                "            CurrentAttempt = if attempt = null then 0 else attempt,",
                "            Response =",
                "                try",
                "                    Web.Contents(",
                "                        \"https://access.redhat.com\",",
                "                        [",
                "                            RelativePath = \"hydra/rest/securitydata/csaf.json\",",
                "                            Query = [",
                "                                package = packageName,",
                "                                after = Date.ToText(CutoffDate, [Format = \"yyyy-MM-dd\", Culture = \"en-US\"]),",
                "                                per_page = Text.From(RedHatPageSize),",
                "                                page = Text.From(page),",
                "                                isCompressed = \"false\"",
                "                            ],",
                "                            Headers = [Accept = \"application/json\"],",
                "                            ManualStatusHandling = RetryableStatusCodes",
                "                        ]",
                "                    )",
                "                otherwise",
                "                    null,",
                "            Status = if Response = null then 0 else Record.FieldOrDefault(Value.Metadata(Response), \"Response.Status\", 200),",
                "            Result =",
                "                if Status = 200 then",
                "                    Json.Document(Response)",
                "                else if CurrentAttempt < 3 then",
                "                    Function.InvokeAfter(",
                "                        () => @FetchRedHatPage(packageName, page, CurrentAttempt + 1),",
                "                        #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))",
                "                    )",
                "                else",
                "                    error Error.Record(",
                "                        \"RedHatSecurityFeedUnavailable\",",
                "                        \"The Red Hat CSAF package query could not be retrieved after four attempts.\",",
                "                        [Package = packageName, Page = page, Status = Status]",
                "                    )",
                "        in",
                "            Result,",
                "    GetRedHatAdvisories = (packageName as text) as list =>",
                "        let",
                "            Pages =",
                "                List.Generate(",
                "                    () => [Page = 1, Payload = FetchRedHatPage(packageName, 1)],",
                "                    each [Payload] <> null,",
                "                    each [",
                "                        Page = [Page] + 1,",
                "                        Payload = if List.Count([Payload]) = RedHatPageSize then FetchRedHatPage(packageName, [Page] + 1) else null",
                "                    ],",
                "                    each [Payload]",
                "                )",
                "        in",
                "            List.Combine(Pages),",
                "    ParseReleasedPackage = (packageName as text, packageNevra as text) as nullable record =>",
                "        let",
                "            Prefix = packageName & \"-\",",
                "            Remainder = if Text.StartsWith(Text.Lower(packageNevra), Text.Lower(Prefix)) then Text.Range(packageNevra, Text.Length(Prefix)) else \"\",",
                "            HasEpoch = Text.Contains(Remainder, \":\"),",
                "            Epoch = if HasEpoch then Text.BeforeDelimiter(Remainder, \":\") else \"\",",
                "            IsExactPackage = Epoch <> \"\" and Text.Select(Epoch, {\"0\"..\"9\"}) = Epoch,",
                "            Architecture = if IsExactPackage and Text.Contains(Remainder, \".\") then Text.AfterDelimiter(Remainder, \".\", {0, RelativePosition.FromEnd}) else \"\",",
                "            VersionWithEpoch = if Architecture <> \"\" then Text.BeforeDelimiter(Remainder, \".\", {0, RelativePosition.FromEnd}) else \"\",",
                "            Release =",
                "                if Text.Contains(Text.Lower(packageNevra), \".el10\") then \"10\"",
                "                else if Text.Contains(Text.Lower(packageNevra), \".el9\") then \"9\"",
                "                else if Text.Contains(Text.Lower(packageNevra), \".el8\") then \"8\"",
                "                else if Text.Contains(Text.Lower(packageNevra), \".el7\") then \"7\"",
                "                else \"\",",
                "            Result = if IsExactPackage and Text.Lower(Architecture) <> \"src\" and Release <> \"\" then [version = VersionWithEpoch, release = Release] else null",
                "        in",
                "            Result,",
                "    RedHatRows =",
                "        List.Combine(",
                "            List.Transform(",
                "                RhelPackages,",
                "                (packageName as text) =>",
                "                    let",
                "                        PackageTargets =",
                "                            Table.SelectRows(",
                "                                RhelRelevantRows,",
                "                                each Text.Lower(Text.Trim(Text.From([patch_name]))) = packageName",
                "                            ),",
                "                        Advisories = GetRedHatAdvisories(packageName)",
                "                    in",
                "                        List.Combine(",
                "                            List.Transform(",
                "                                Advisories,",
                "                                (advisory as record) =>",
                "                                    let",
                "                                        AdvisoryId = Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(advisory, \"RHSA\", \"\")))),",
                "                                        Severity = Text.Proper(Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(advisory, \"severity\", \"Unknown\"))))),",
                "                                        Published = try DateTime.From(DateTimeZone.FromText(Text.From(Record.FieldOrDefault(advisory, \"released_on\", null)))) otherwise null,",
                "                                        CveIds = Record.FieldOrDefault(advisory, \"CVEs\", {}),",
                "                                        ReleasedPackages = Record.FieldOrDefault(advisory, \"released_packages\", {}),",
                "                                        ParsedPackages = List.RemoveNulls(List.Transform(ReleasedPackages, each ParseReleasedPackage(packageName, Text.From(_)))),",
                "                                        SourceUrl = \"https://access.redhat.com/errata/\" & AdvisoryId",
                "                                    in",
                "                                        List.Combine(",
                "                                            List.Transform(",
                "                                                ParsedPackages,",
                "                                                (releasedPackage as record) =>",
                "                                                    let",
                "                                                        Release = Text.From(releasedPackage[release]),",
                "                                                        FixedVersion = Text.From(releasedPackage[version]),",
                "                                                        MatchingTargets =",
                "                                                            Table.SelectRows(",
                "                                                                PackageTargets,",
                "                                                                each",
                "                                                                    Text.Trim(Text.From([release_codename])) = Release",
                "                                                                        and NormalizeRpmVersion([package_version]) = NormalizeRpmVersion(FixedVersion)",
                "                                                            )",
                "                                                    in",
                "                                                        List.Combine(",
                "                                                            List.Transform(",
                "                                                                Table.ToRecords(MatchingTargets),",
                "                                                                (target as record) =>",
                "                                                                    List.Transform(",
                "                                                                        CveIds,",
                "                                                                        (cve as text) => [",
                "                                                                            distribution = \"Red Hat Enterprise Linux\",",
                "                                                                            release_codename = Release,",
                "                                                                            package_name = packageName,",
                "                                                                            package_version = Text.Trim(Text.From(target[package_version])),",
                "                                                                            advisory_id = AdvisoryId,",
                "                                                                            cve_id = Text.Upper(Text.Trim(cve)),",
                "                                                                            severity = Severity,",
                "                                                                            product = \"Red Hat Enterprise Linux \" & Release,",
                "                                                                            published_at = Published,",
                "                                                                            mapping_source = \"Red Hat CSAF\",",
                "                                                                            source_url = SourceUrl",
                "                                                                        ]",
                "                                                                    )",
                "                                                            )",
                "                                                        )",
                "                                            )",
                "                                        )",
                "                            )",
                "                        )",
                "            )",
                "        ),",
                "    DebianRelevantRows =",
                "        Table.Buffer(",
                "            Table.SelectRows(",
                "                view_missing_patches,",
                "                each",
                "                    Text.Lower(Text.Trim(Text.From([os_type]))) = \"linux\"",
                "                        and [os_distribution] = \"Debian GNU/Linux\"",
                "                        and List.Contains(SupportedDebianReleases, Text.Lower(Text.Trim(Text.From([release_codename]))))",
                "                        and [patch_name] <> null",
                "                        and Text.Trim(Text.From([patch_name])) <> \"\"",
                "                        and [package_version] <> null",
                "                        and Text.Trim(Text.From([package_version])) <> \"\"",
                "            )",
                "        ),",
                "    DebianPackages =",
                "        List.Buffer(",
                "            List.Distinct(",
                "                List.Transform(",
                "                    Table.Column(DebianRelevantRows, \"patch_name\"),",
                "                    each Text.Lower(Text.Trim(Text.From(_)))",
                "                )",
                "            )",
                "        ),",
                "    FetchDebianPackageMetadata = (packageName as text, optional attempt as nullable number) as list =>",
                "        let",
                "            CurrentAttempt = if attempt = null then 0 else attempt,",
                "            Response =",
                "                try",
                "                    Web.Contents(",
                "                        \"https://snapshot.debian.org\",",
                "                        [",
                "                            RelativePath = \"mr/binary/\" & Uri.EscapeDataString(packageName) & \"/\",",
                "                            Headers = [Accept = \"application/json\"],",
                "                            ManualStatusHandling = RetryableStatusCodes",
                "                        ]",
                "                    )",
                "                otherwise",
                "                    null,",
                "            Status = if Response = null then 0 else Record.FieldOrDefault(Value.Metadata(Response), \"Response.Status\", 200),",
                "            Result =",
                "                if Status = 200 then",
                "                    Record.FieldOrDefault(Json.Document(Response), \"result\", {})",
                "                else if CurrentAttempt < 3 then",
                "                    Function.InvokeAfter(",
                "                        () => @FetchDebianPackageMetadata(packageName, CurrentAttempt + 1),",
                "                        #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))",
                "                    )",
                "                else",
                "                    error Error.Record(",
                "                        \"DebianSnapshotUnavailable\",",
                "                        \"Debian Snapshot package metadata could not be retrieved after four attempts.\",",
                "                        [Package = packageName, Status = Status]",
                "                    )",
                "        in",
                "            Result,",
                "    DebianPackageMetadata =",
                "        Record.FromList(",
                "            List.Transform(DebianPackages, each List.Buffer(FetchDebianPackageMetadata(_))),",
                "            DebianPackages",
                "        ),",
                "    DebianResolvedTargets =",
                "        List.RemoveNulls(",
                "            List.Transform(",
                "                Table.ToRecords(DebianRelevantRows),",
                "                (target as record) =>",
                "                    let",
                "                        PackageName = Text.Lower(Text.Trim(Text.From(target[patch_name]))),",
                "                        TargetVersion = Text.Trim(Text.From(target[package_version])),",
                "                        MetadataRows = Record.FieldOrDefault(DebianPackageMetadata, PackageName, {}),",
                "                        Match = List.First(List.Select(MetadataRows, each Text.From(Record.FieldOrDefault(_, \"binary_version\", \"\")) = TargetVersion), null)",
                "                    in",
                "                        if Match = null then",
                "                            null",
                "                        else",
                "                            [",
                "                                release = Text.Lower(Text.Trim(Text.From(target[release_codename]))),",
                "                                package_name = PackageName,",
                "                                package_version = TargetVersion,",
                "                                source_package = Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(Match, \"source\", \"\")))),",
                "                                source_version = Text.Trim(Text.From(Record.FieldOrDefault(Match, \"version\", \"\")))",
                "                            ]",
                "            )",
                "        ),",
                "    FetchDebianTracker = (optional attempt as nullable number) as record =>",
                "        let",
                "            CurrentAttempt = if attempt = null then 0 else attempt,",
                "            Response =",
                "                try",
                "                    Web.Contents(",
                "                        \"https://security-tracker.debian.org\",",
                "                        [",
                "                            RelativePath = \"tracker/data/json\",",
                "                            Headers = [Accept = \"application/json\"],",
                "                            ManualStatusHandling = RetryableStatusCodes",
                "                        ]",
                "                    )",
                "                otherwise",
                "                    null,",
                "            Status = if Response = null then 0 else Record.FieldOrDefault(Value.Metadata(Response), \"Response.Status\", 200),",
                "            Result =",
                "                if Status = 200 then",
                "                    Json.Document(Response)",
                "                else if CurrentAttempt < 3 then",
                "                    Function.InvokeAfter(",
                "                        () => @FetchDebianTracker(CurrentAttempt + 1),",
                "                        #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))",
                "                    )",
                "                else",
                "                    error Error.Record(",
                "                        \"DebianSecurityTrackerUnavailable\",",
                "                        \"Debian Security Tracker data could not be retrieved after four attempts.\",",
                "                        [Status = Status]",
                "                    )",
                "        in",
                "            Result,",
                "    DebianTracker = if List.IsEmpty(DebianResolvedTargets) then [] else FetchDebianTracker(),",
                "    DebianRows =",
                "        List.Combine(",
                "            List.Transform(",
                "                DebianResolvedTargets,",
                "                (target as record) =>",
                "                    let",
                "                        SourcePackage = Text.From(target[source_package]),",
                "                        SourceVersion = Text.From(target[source_version]),",
                "                        Release = Text.From(target[release]),",
                "                        Vulnerabilities = Record.FieldOrDefault(DebianTracker, SourcePackage, []),",
                "                        VulnerabilityRows = if Vulnerabilities is record then Table.ToRecords(Record.ToTable(Vulnerabilities)) else {}",
                "                    in",
                "                        List.RemoveNulls(",
                "                            List.Transform(",
                "                                VulnerabilityRows,",
                "                                (vulnerability as record) =>",
                "                                    let",
                "                                        CveId = Text.Upper(Text.Trim(Text.From(vulnerability[Name]))),",
                "                                        Detail = vulnerability[Value],",
                "                                        Releases = if Detail is record then Record.FieldOrDefault(Detail, \"releases\", []) else [],",
                "                                        ReleaseDetail = if Releases is record then Record.FieldOrDefault(Releases, Release, null) else null,",
                "                                        Status = if ReleaseDetail is record then Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(ReleaseDetail, \"status\", \"\")))) else \"\",",
                "                                        FixedVersion = if ReleaseDetail is record then Text.Trim(Text.From(Record.FieldOrDefault(ReleaseDetail, \"fixed_version\", \"\"))) else \"\",",
                "                                        Urgency = if ReleaseDetail is record then Text.Proper(Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(ReleaseDetail, \"urgency\", \"Unknown\"))))) else \"Unknown\"",
                "                                    in",
                "                                        if Text.StartsWith(CveId, \"CVE-\") and Status = \"resolved\" and FixedVersion <> \"\" and FixedVersion <> \"0\" and FixedVersion = SourceVersion then",
                "                                            [",
                "                                                distribution = \"Debian GNU/Linux\",",
                "                                                release_codename = Release,",
                "                                                package_name = Text.From(target[package_name]),",
                "                                                package_version = Text.From(target[package_version]),",
                "                                                advisory_id = \"Debian \" & CveId,",
                "                                                cve_id = CveId,",
                "                                                severity = Urgency,",
                "                                                product = SourcePackage,",
                "                                                published_at = null,",
                "                                                mapping_source = \"Debian Security Tracker\",",
                "                                                source_url = \"https://security-tracker.debian.org/tracker/\" & CveId",
                "                                            ]",
                "                                        else",
                "                                            null",
                "                            )",
                "                        )",
                "            )",
                "        ),",
                "    SuseRelevantRows = Table.Buffer(Table.SelectRows(view_missing_patches, each Text.Lower(Text.Trim(Text.From([os_type]))) = \"linux\" and [os_distribution] = \"SUSE Linux Enterprise Server\" and List.Contains(SupportedSuseReleases, Text.Trim(Text.From([release_codename]))) and [patch_name] <> null and Text.Trim(Text.From([patch_name])) <> \"\" and [package_version] <> null and Text.Trim(Text.From([package_version])) <> \"\")),",
                "    SuseTargets = List.Buffer(Table.ToRecords(SuseRelevantRows)),",
                "    SusePackages = List.Buffer(List.Distinct(List.Transform(Table.Column(SuseRelevantRows, \"patch_name\"), each Text.Lower(Text.Trim(Text.From(_)))))),",
                "    FetchSuseSearchPage = (packageName as text, page as number, optional attempt as nullable number) as record =>",
                "        let",
                "            CurrentAttempt = if attempt = null then 0 else attempt,",
                "            Response = try Web.Contents(\"https://www.suse.com\", [RelativePath = \"support/ajax/\", Query = [keywords = packageName, category = \"security\", date_from = Date.ToText(CutoffDate, [Format = \"yyyy-MM-dd\", Culture = \"en-US\"]), pagination = \"100\", page = Text.From(page)], Headers = [Accept = \"application/json\"], ManualStatusHandling = RetryableStatusCodes]) otherwise null,",
                "            Status = if Response = null then 0 else Record.FieldOrDefault(Value.Metadata(Response), \"Response.Status\", 200),",
                "            Result = if Status = 200 then Json.Document(Response) else if CurrentAttempt < 3 then Function.InvokeAfter(() => @FetchSuseSearchPage(packageName, page, CurrentAttempt + 1), #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))) else error Error.Record(\"SuseAdvisorySearchUnavailable\", \"The SUSE advisory package search could not be retrieved after four attempts.\", [Package = packageName, Page = page, Status = Status])",
                "        in",
                "            Result,",
                "    GetSuseAdvisorySearchResults = (packageName as text) as list =>",
                "        let",
                "            FirstPayload = FetchSuseSearchPage(packageName, 1),",
                "            PageCount = try Number.From(Record.FieldOrDefault(FirstPayload, \"pages\", 1)) otherwise 1,",
                "            OtherPayloads = if PageCount > 1 then List.Transform({2..PageCount}, each FetchSuseSearchPage(packageName, _)) else {},",
                "            Payloads = List.Combine({{FirstPayload}, OtherPayloads})",
                "        in",
                "            List.Combine(List.Transform(Payloads, each Record.FieldOrDefault(_, \"results\", {}))),",
                "    SuseAdvisoryIds = if List.IsEmpty(SusePackages) then {} else List.Buffer(List.Distinct(List.RemoveNulls(List.Combine(List.Transform(SusePackages, (packageName as text) => List.Transform(GetSuseAdvisorySearchResults(packageName), each let AdvisoryId = Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(_, \"announcement_id\", \"\")))) in if Text.StartsWith(AdvisoryId, \"SUSE-SU-\") then AdvisoryId else null)))))),",
                "    FetchSuseCsaf = (advisoryId as text, optional attempt as nullable number) as nullable record =>",
                "        let",
                "            CurrentAttempt = if attempt = null then 0 else attempt,",
                "            FileName = Text.Lower(Text.Replace(advisoryId, \":\", \"_\")) & \".json\",",
                "            Response = try Web.Contents(\"https://ftp.suse.com\", [RelativePath = \"pub/projects/security/csaf/\" & FileName, Headers = [Accept = \"application/json\"], ManualStatusHandling = List.Combine({RetryableStatusCodes, {404}})]) otherwise null,",
                "            Status = if Response = null then 0 else Record.FieldOrDefault(Value.Metadata(Response), \"Response.Status\", 200),",
                "            Result = if Status = 200 then Json.Document(Response) else if Status = 404 then null else if CurrentAttempt < 3 then Function.InvokeAfter(() => @FetchSuseCsaf(advisoryId, CurrentAttempt + 1), #duration(0, 0, 0, Number.Power(2, CurrentAttempt + 1))) else error Error.Record(\"SuseCsafUnavailable\", \"A SUSE CSAF advisory could not be retrieved after four attempts.\", [Advisory = advisoryId, Status = Status])",
                "        in",
                "            Result,",
                "    SuseAdvisories = if List.IsEmpty(SuseAdvisoryIds) then {} else List.Buffer(List.RemoveNulls(List.Transform(SuseAdvisoryIds, each FetchSuseCsaf(_)))),",
                "    SuseRows = List.Combine(List.Transform(SuseAdvisories, (advisory as record) => let Document = Record.FieldOrDefault(advisory, \"document\", []), Tracking = if Document is record then Record.FieldOrDefault(Document, \"tracking\", []) else [], AdvisoryId = if Tracking is record then Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(Tracking, \"id\", \"\")))) else \"\", SeverityRecord = if Document is record then Record.FieldOrDefault(Document, \"aggregate_severity\", []) else [], Severity = if SeverityRecord is record then Text.Proper(Text.Lower(Text.Trim(Text.From(Record.FieldOrDefault(SeverityRecord, \"text\", \"Unknown\"))))) else \"Unknown\", Published = if Tracking is record then try DateTime.From(DateTimeZone.FromText(Text.From(Record.FieldOrDefault(Tracking, \"initial_release_date\", null)))) otherwise null else null, ProductTree = Record.FieldOrDefault(advisory, \"product_tree\", []), Relationships = if ProductTree is record then Record.FieldOrDefault(ProductTree, \"relationships\", {}) else {}, Vulnerabilities = Record.FieldOrDefault(advisory, \"vulnerabilities\", {}), SourceUrl = \"https://ftp.suse.com/pub/projects/security/csaf/\" & Text.Lower(Text.Replace(AdvisoryId, \":\", \"_\")) & \".json\" in List.Combine(List.Transform(SuseTargets, (target as record) => let PackageName = Text.Lower(Text.Trim(Text.From(target[patch_name]))), PackageVersion = Text.Trim(Text.From(target[package_version])), Release = Text.Trim(Text.From(target[release_codename])), ExpectedProduct = \"SUSE Linux Enterprise Server \" & Release, MatchingRelationships = List.Select(Relationships, each let ProductReference = Text.From(Record.FieldOrDefault(_, \"product_reference\", \"\")), RelatedProduct = Text.From(Record.FieldOrDefault(_, \"relates_to_product_reference\", \"\")) in Text.StartsWith(ProductReference, PackageName & \"-\" & PackageVersion & \".\", Comparer.OrdinalIgnoreCase) and RelatedProduct = ExpectedProduct) in List.Combine(List.Transform(MatchingRelationships, (relationship as record) => let FullProduct = Record.FieldOrDefault(relationship, \"full_product_name\", []), FullProductId = if FullProduct is record then Text.From(Record.FieldOrDefault(FullProduct, \"product_id\", \"\")) else \"\", MatchingVulnerabilities = List.Select(Vulnerabilities, each let ProductStatus = Record.FieldOrDefault(_, \"product_status\", []), RecommendedProducts = if ProductStatus is record then Record.FieldOrDefault(ProductStatus, \"recommended\", {}) else {}, Remediations = Record.FieldOrDefault(_, \"remediations\", {}), RemediationProducts = List.Combine(List.Transform(Remediations, each Record.FieldOrDefault(_, \"product_ids\", {}))) in FullProductId <> \"\" and (List.Contains(RecommendedProducts, FullProductId) or List.Contains(RemediationProducts, FullProductId))) in List.RemoveNulls(List.Transform(MatchingVulnerabilities, (vulnerability as record) => let CveId = Text.Upper(Text.Trim(Text.From(Record.FieldOrDefault(vulnerability, \"cve\", \"\")))) in if Text.StartsWith(CveId, \"CVE-\") then [distribution = \"SUSE Linux Enterprise Server\", release_codename = Release, package_name = PackageName, package_version = PackageVersion, advisory_id = AdvisoryId, cve_id = CveId, severity = Severity, product = ExpectedProduct, published_at = Published, mapping_source = \"SUSE CSAF\", source_url = SourceUrl] else null)))))))),",
                "    Mappings =",
                "        Table.FromRecords(",
                "            List.Combine({MappingRows, RedHatRows, DebianRows, SuseRows}),",
                "            type table [",
                "                distribution = text,",
                "                release_codename = text,",
                "                package_name = text,",
                "                package_version = text,",
                "                advisory_id = text,",
                "                cve_id = text,",
                "                severity = text,",
                "                product = text,",
                "                published_at = nullable datetime,",
                "                mapping_source = text,",
                "                source_url = text",
                "            ]",
                "        ),",
                "    DistinctMappings =",
                "        Table.Distinct(",
                "            Mappings,",
                "            {\"distribution\", \"release_codename\", \"package_name\", \"package_version\", \"advisory_id\", \"cve_id\"}",
                "        )",
                "in",
                "    DistinctMappings"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_patch_kb",
        "description": "Shared Knowledge Base dimension used to filter missing-patch and CVE evidence consistently.",
        "isHidden": true,
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "kb_numeric",
            "dataType": "string",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[kb_numeric]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_patch_kb",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR _missingPatchKbs =",
                "    SELECTCOLUMNS (",
                "        FILTER (",
                "            view_missing_patches,",
                "            NOT ISBLANK ( view_missing_patches[kb_id] )",
                "                && view_missing_patches[kb_id] <> \"\"",
                "        ),",
                "        \"kb_numeric\", view_missing_patches[kb_id] & \"\"",
                "    )",
                "VAR _mappedKbs =",
                "    SELECTCOLUMNS (",
                "        FILTER (",
                "            dim_patch_cve_mapping,",
                "            NOT ISBLANK ( dim_patch_cve_mapping[kb_numeric] )",
                "                && dim_patch_cve_mapping[kb_numeric] <> \"\"",
                "        ),",
                "        \"kb_numeric\", dim_patch_cve_mapping[kb_numeric] & \"\"",
                "    )",
                "RETURN",
                "    DISTINCT ( UNION ( _missingPatchKbs, _mappedKbs ) )"
              ]
            }
          }
        ]
      },
      {
        "name": "view_patch_cve_mappings",
        "description": "Machine-level CVE exposure derived from Update Manager patch evidence and authoritative Windows and Linux vendor advisories.",
        "lineageTag": "c5ac691d-8652-443e-8b44-a43148c72ba3",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "resource_key",
            "dataType": "int64",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[resource_key]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "machine_resource_id",
            "dataType": "string",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[machine_resource_id]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "machine_name",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[machine_name]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "kb_id",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[kb_id]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "kb_numeric",
            "dataType": "string",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[kb_numeric]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "advisory_reference",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[advisory_reference]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "package_version",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[package_version]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
