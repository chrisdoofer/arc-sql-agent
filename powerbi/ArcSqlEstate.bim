        "partitions": [
          {
            "name": "dim_extension_types",
            "mode": "import",
            "queryGroup": "Dimensions",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // 1. Pull the data",
                "    Source = Csv.Document(",
                "        Web.Contents(\"https://raw.githubusercontent.com/Azure/arc_jumpstart_drops/refs/heads/main/ui_dashboard_workbook/arc_pbi_dashboard/artifacts/reference/dim_extension_types.csv\"),",
                "        [Delimiter=\",\", Columns=6, Encoding=1252, QuoteStyle=QuoteStyle.None]",
                "    ),",
                "    ",
                "    // 2. Promote Headers",
                "    Header = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    ",
                "    // 3. Add Index (Surrogate Key)",
                "    AddKey = Table.AddIndexColumn(Header, \"extension_type_key\", 1, 1, Int64.Type),",
                "",
                "    // 4. Type Casting (Crucial for performance in visuals)",
                "    // Replace \"Column Name\" with your actual column names",
                "    Typed = Table.TransformColumnTypes(AddKey, {",
                "        {\"extension_type_key\", Int64.Type}",
                "        // Add other columns here, e.g., {\"ExtensionName\", type text}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "changedProperties": [
          {
            "property": "IsHidden"
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
