          {
            "type": "calculated",
            "name": "last_heartbeat_hrs",
            "dataType": "int64",
            "expression": [
              "",
              "VAR dt = view_arc_sql_databases[last_database_upload_time]",
              "VAR secs =",
              "    IF ( NOT ISBLANK ( dt ), DATEDIFF ( dt, UTCNOW(), SECOND ) )",
              "RETURN IF ( ISBLANK ( dt ) || secs < 0, BLANK(), DIVIDE ( secs, 3600 ) )"
            ],
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "sql_db_full_name",
            "expression": [
              "",
              "[sql_instance_name]",
              "& \"\\\" & ",
              "[sql_database_name]"
            ],
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
