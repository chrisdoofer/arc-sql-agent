            ],
            "formatString": "0",
            "displayFolder": "kpi\\sql databases"
          },
          {
            "name": "sql_database_type_user",
            "expression": [
              "",
              "CALCULATE (",
              "    COUNTROWS(view_arc_sql_databases), FILTER (",
