          {
            "name": "arc_sql_warning_latency_hrs",
            "expression": "IF([arc_sql_total_latency_hrs] > 720 && [arc_sql_total_latency_hrs] <= 1080, [arc_sql_total_latency_hrs], BLANK())",
            "formatString": "0",
            "displayFolder": "kpi\\sql instances"
