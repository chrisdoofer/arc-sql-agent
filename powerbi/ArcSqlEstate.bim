            "expression": [
              "",
              "DIVIDE (",
              "    [kpi_change_tracking_windows_count] + [kpi_change_tracking_linux_count],",
              "    [kpi_change_tracking_windows_count] + [kpi_change_tracking_linux_count] + [kpi_change_tracking_not_installed]",
              ")",
