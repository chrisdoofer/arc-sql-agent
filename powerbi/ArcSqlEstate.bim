          {
            "name": "kpi_change_tracking_not_installed",
            "expression": [
              "",
              "CALCULATE (",
              "    COUNTROWS ( view_extension_deployments ),",
              "    KEEPFILTERS (",
              "        LOWER ( TRIM ( view_extension_deployments[extension_change_tracking] ) ) = \"notdeployed\"",
              "    )",
              ")",
              ""
            ],
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
