            "formatString": "0",
            "displayFolder": "kpi\\sql instances"
          },
          {
            "name": "kpi_azure_monitor_pct",
            "expression": [
              "",
              "DIVIDE (",
              "    [kpi_azure_monitor_windows_count] + [kpi_azure_monitor_linux_count],",
              "    [kpi_azure_monitor_windows_count] + [kpi_azure_monitor_linux_count] + [kpi_azure_monitor_not_installed]",
              ")",
