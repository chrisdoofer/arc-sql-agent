                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Index",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Index",
            "formatString": "0",
            "summarizeBy": "sum",
            "changedProperties": [
              {
