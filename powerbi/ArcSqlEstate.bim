          },
          {
            "name": "kpi_admin_center_not_installed",
            "expression": [
              "",
              "CALCULATE (",
              "    COUNTROWS ( view_extension_deployments ),",
              "    KEEPFILTERS (",
              "        LOWER ( TRIM ( view_extension_deployments[extension_admin_center] ) ) = \"notdeployed\"",
