            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "kpi_arc_extension_count",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS(view_extensions),",
              "    FILTER(",
              "        view_extensions,",
              "        view_extensions[platform] = \"Arc\"",
              "    )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "kpi_azure_extension_count",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS(view_extensions),",
              "    FILTER(",
              "        view_extensions,",
              "        view_extensions[platform] = \"Azure\"",
              "    )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "discount_azure_run_cost",
            "expression": "([azure_run_cost] /100)*44.8741",
            "displayFolder": "kpi\\esu\\azure",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "azure_run_cost_discount",
            "expression": [
              "",
              "VAR selected_discount_SQL = SELECTEDVALUE(dim_sql_savings_plan[type], \"None - Pay As You Go\")",
              "VAR selected_discount_Server = SELECTEDVALUE(dim_server_savings_plan[type], \"None - Pay As You Go\")",
              "",
              "-- Get SQL discount",
              "VAR sql_discount =",
              "    CALCULATE(",
              "        MAX(dim_sql_savings_plan[discount]),",
              "        TREATAS({ selected_discount_SQL }, dim_sql_savings_plan[type])",
              "    )",
              "",
              "-- Get Server (VM) discount",
              "VAR server_discount =",
              "    CALCULATE(",
              "        MAX(dim_server_savings_plan[discount]),",
              "        TREATAS({ selected_discount_Server }, dim_server_savings_plan[type])",
              "    )",
              "",
              "VAR ModernisationType = [azure_modernisation_path]",
              "",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ModernisationType IN { \"SQL DB\", \"SQL MI\" }, sql_discount,",
              "        ModernisationType IN { \"VM\", \"VM*\" }, server_discount,",
              "        1.0",
              "    )"
            ],
            "displayFolder": "kpi\\esu\\azure",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "azure_modernisation_type",
            "expression": [
              "",
              "IF (",
              "    HASONEVALUE(view_esu[resource_key]),",
              "    SWITCH (",
              "        [azure_modernisation_path],",
              "        \"SQL MI\", \"PaaS\",",
              "        \"SQL DB\", \"PaaS\",",
              "        \"VM\", \"IaaS\",",
              "        \"VM*\", \"IaaS\",",
              "        BLANK()",
              "    ),",
              "    BLANK()",
              ")",
              ""
            ],
            "displayFolder": "kpi\\esu\\azure"
          },
          {
            "name": "azure_modernisation_path",
            "expression": [
              "",
              "VAR Strategy =",
              "    SELECTEDVALUE ( dim_migration_strategy[migration_strategy], \"Modernize to PaaS\" )",
              "",
              "-- Pull from the *bridge* row that the visual is rendering",
              "VAR db_status = SELECTEDVALUE ( view_esu[db_status] )",
              "VAR mi_status = SELECTEDVALUE ( view_esu[mi_status] )",
              "VAR vm_status = SELECTEDVALUE ( view_esu[vm_status] )",
              "",
              "VAR db_cost = SELECTEDVALUE ( view_esu[db_total_cost] )",
              "VAR mi_cost = SELECTEDVALUE ( view_esu[mi_total_cost] )",
              "VAR vm_cost = SELECTEDVALUE ( view_esu[vm_total_cost] )",
              "",
              "VAR db_ready = db_status = \"Ready\" && NOT ISBLANK ( db_cost )",
              "VAR mi_ready = mi_status = \"Ready\" && NOT ISBLANK ( mi_cost )",
              "VAR vm_ready = vm_status = \"Ready\" && NOT ISBLANK ( vm_cost )",
              "",
              "VAR CheapestReady =",
              "    SWITCH (",
              "        TRUE(),",
              "        db_ready && (NOT mi_ready || db_cost <= mi_cost) && (NOT vm_ready || db_cost <= vm_cost), \"SQL DB\",",
              "        mi_ready && (NOT db_ready || mi_cost <= db_cost) && (NOT vm_ready || mi_cost <= vm_cost), \"SQL MI\",",
              "        vm_ready, \"VM\",",
              "        \"VM*\"",
              "    )",
              "",
              "VAR PaasChoice =",
              "    SWITCH ( TRUE(),",
              "        db_ready, \"SQL DB\",",
              "        mi_ready, \"SQL MI\",",
              "        vm_ready, \"VM\",",
              "        \"VM*\"",
              "    )",
              "",
              "RETURN",
              "    IF ( Strategy = \"Minimize cost\", CheapestReady, PaasChoice )"
            ],
            "displayFolder": "kpi\\esu\\azure"
          },
          {
            "name": "azure_run_cost_monthly",
            "expression": [
              "",
              "CALCULATE(",
              "    SUMX(",
              "        view_esu,",
              "        VAR mstatus = [azure_modernisation_status]",
              "        VAR cores = MAX(COALESCE([logical_cores], 0), 2)",
              "",
              "        VAR mi_compute = COALESCE([mi_compute_cost], 0)",
              "        VAR db_compute = COALESCE([db_compute_cost], 0)",
              "        VAR vm_compute = COALESCE([vm_compute_cost], 0)",
              "",
              "        VAR mi_storage = COALESCE([mi_storage_cost], 0)",
              "        VAR db_storage = COALESCE([db_storage_cost], 0)",
              "        VAR vm_storage = COALESCE([vm_storage_cost], 0)",
              "",
              "        VAR discount = COALESCE([azure_run_cost_discount], 1)",
              "        VAR user_db_count = COALESCE([user_db_count], 0)",
              "",
              "        VAR compute_cost =",
              "            SWITCH(",
              "                TRUE(),",
              "                mstatus = \"VM*\", IF(cores > 2, 47.5 * cores, 47.5),",
              "                mstatus = \"VM\", vm_compute,",
              "                mstatus = \"SQL MI\", mi_compute,",
              "                mstatus = \"SQL DB\", db_compute,",
              "                0",
              "            )",
              "",
              "        VAR storage_cost =",
              "            SWITCH(",
              "                TRUE(),",
              "                mstatus = \"VM*\", 25,",
              "                mstatus = \"VM\", vm_storage,",
              "                mstatus = \"SQL MI\", mi_storage,",
              "                mstatus = \"SQL DB\", db_storage,",
              "                0",
              "            )",
              "",
              "        RETURN (compute_cost * discount + storage_cost)",
              "    )",
              ")"
            ],
            "displayFolder": "kpi\\esu\\azure",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "azure_run_cost_quarterly",
            "expression": [
              "",
              "CALCULATE(",
              "    [azure_run_cost_monthly] * 3,",
              "    REMOVEFILTERS(dim_period_selector) // Ignore slicer if needed",
              ")",
              "",
              ""
            ],
            "displayFolder": "kpi\\esu\\azure",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "sql_patch_status_pct",
            "expression": [
              "",
              "DIVIDE(",
              "    CALCULATE(",
              "        COUNTROWS(view_sql_instances),",
              "        view_sql_instances[sql_patch_status] = \"OK\"",
              "    ),",
              "    COUNTROWS(view_sql_instances),",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "kpi\\sql instances"
          },
          {
            "name": "kpi_arc_instance_count_database",
            "expression": [
              "",
              "VAR inst_keys_from_db =",
              "    CALCULATETABLE (",
              "        VALUES ( fact_resources[parent_resource_key] ),",
              "        KEEPFILTERS ( LOWER ( TRIM ( fact_resources[platform] ) ) = \"arc\" ),",
              "        KEEPFILTERS ( LOWER ( TRIM ( fact_resources[resource_kind] ) ) = \"sql database\" )",
              "    )",
              "RETURN",
              " COUNTROWS ( inst_keys_from_db )",
              "",
              ""
            ],
            "formatString": "0",
            "displayFolder": "kpi\\sql databases"
          },
          {
            "name": "kpi_extensions_arc_server_count",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('view_extensions'[parent_resource_key]),",
              "    KEEPFILTERS('view_extensions'[platform] = \"Arc\")",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "kpi_extensions_azure_server_count",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('view_extensions'[parent_resource_key]),",
              "    KEEPFILTERS('view_extensions'[platform] = \"Azure\")",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "kpi_extensions_server_count",
            "expression": "COUNTROWS(view_extension_deployments)",
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "os_vm_migration_cost",
            "expression": [
              "",
              "VAR SelectedMonths = SELECTEDVALUE(dim_period_selector[months], 0)",
              "RETURN",
              "SUMX(",
              "    ext_arc_servers,",
              "    COALESCE([logical_cores], 0) * SelectedMonths * 47.5",
              ")",
              "",
              ""
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "isHidden": true,
            "displayFolder": "kpi\\esu",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "os_vm_migration_ready",
            "expression": [
              "",
              "VAR Total = COUNTROWS(ext_arc_servers)",
              "VAR VMReady =",
              "    CALCULATE(",
              "        COUNTROWS(ext_arc_servers),",
              "        SEARCH(\"Virtual Machine\", ext_arc_servers[Model], 1, 0) > 0",
              "    )",
              "RETURN",
              "DIVIDE(VMReady, Total, 0)",
              ""
            ],
            "isHidden": true,
            "displayFolder": "kpi\\esu",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "os_vm_migration_ready_%",
            "expression": [
              "",
              "VAR Total = COUNTROWS(ext_arc_servers)",
              "VAR VMReady =",
              "    CALCULATE(",
              "        COUNTROWS(ext_arc_servers),",
              "        SEARCH(\"Virtual Machine\", ext_arc_servers[Model], 1, 0) > 0",
              "    )",
              "RETURN",
              "DIVIDE(VMReady, Total, 0)",
              ""
            ],
            "formatString": "0%;-0%;0%",
            "isHidden": true,
            "displayFolder": "kpi\\esu",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "total_resources",
            "expression": "COUNTROWS('fact_resources')",
            "formatString": "0",
            "displayFolder": "general"
          },
          {
            "name": "kpi_all_databases",
            "expression": "countrows(view_arc_sql_databases)",
            "formatString": "0",
            "displayFolder": "kpi\\sql databases"
          },
          {
            "name": "kpi_all_extension_count",
            "expression": "countrows(view_extensions)",
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "kpi_extensions_deployed_count",
            "expression": "countrows(view_extension_deployments)",
            "formatString": "0",
            "displayFolder": "kpi\\extensions"
          },
          {
            "name": "kpi_total_esu_count",
            "expression": "countrows(view_esu)",
            "formatString": "0",
            "displayFolder": "kpi\\esu"
          },
          {
            "name": "sql_cores_license_type",
            "expression": [
              "",
              "VAR SelectedType = SELECTEDVALUE('view_sql_instances'[sql_license_type])",
              "RETURN",
              "IF(",
              "    ISFILTERED('view_sql_instances'[sql_license_type]),",
              "    CALCULATE([kpi_all_sql_cores], 'view_sql_instances'[sql_license_type] = SelectedType),",
              "    CALCULATE([kpi_all_sql_cores], 'view_sql_instances'[sql_license_type] = \"AHUB\")",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\sql instances"
          },
          {
            "name": "sql_license_card_label_text",
            "expression": [
              "",
              "VAR SelectedType = SELECTEDVALUE('view_sql_instances'[sql_license_type], \"AHUB\")",
              "RETURN ",
              "\"SQL Cores under \" & SelectedType"
            ],
            "displayFolder": "kpi\\sql instances"
          },
          {
            "name": "server_cores_license_type",
            "expression": [
              "",
              "VAR SelectedType = SELECTEDVALUE('view_servers'[server_license_type])",
              "RETURN",
              "IF(",
              "    ISFILTERED('view_servers'[server_license_type]),",
              "    CALCULATE([kpi_all_server_cores], 'view_servers'[server_license_type] = SelectedType),",
              "    CALCULATE([kpi_all_server_cores], 'view_servers'[server_license_type] = \"AHUB\")",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\servers"
          },
          {
            "name": "server_license_card_label_text",
            "expression": [
              "",
              "VAR SelectedType = SELECTEDVALUE('view_servers'[server_license_type], \"AHUB\")",
              "RETURN ",
              "\"Server Cores under \" & SelectedType"
            ],
            "displayFolder": "kpi\\servers"
          },
          {
            "name": "kpi_server_cores_ahub",
            "expression": [
              "",
              "CALCULATE(",
              "    [kpi_all_server_cores], ",
              "    'view_servers'[server_license_type] = \"AHUB\"",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\servers"
          },
          {
            "name": "kpi_server_cores_payg",
            "expression": [
              "",
              "CALCULATE(",
              "    [kpi_all_server_cores], ",
              "    'view_servers'[server_license_type] = \"PAYG\"",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\servers"
          },
          {
            "name": "service_type_engine_pct",
            "expression": [
              "",
              "DIVIDE (",
              "    CALCULATE (",
              "        COUNTROWS ( view_sql_instances ),",
              "        view_sql_instances[service_type] = \"Engine\"",
              "    ),",
              "    COUNTROWS ( view_sql_instances )",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "kpi\\sql instances"
          },
          {
            "name": "sql_version_filter",
            "expression": [
              "",
              "VAR is_esu_only = SELECTEDVALUE('view_esu'[esu_status]) = \"TRUE\"",
              "VAR sql_status = SELECTEDVALUE('view_esu'[sql_esu_status])",
              "",
              "RETURN",
              "IF(",
              "    is_esu_only,",
              "    IF(LOWER(TRIM(sql_status)) IN { \"upcoming\", \"esu\" }, 1, 0),",
              "    1",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\esu"
          },
          {
            "name": "kpi_sql_servers_discovered",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS(view_servers),",
              "    view_servers[mssql_discovered] = TRUE()",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "kpi\\servers"
          },
          {
            "name": "kpi_enterprise_sql_instance_count",
            "description": "Number of Arc-enabled SQL Server instances running an Enterprise edition.",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS(view_sql_instances),",
              "    view_sql_instances[platform] = \"Arc\",",
              "    FILTER(view_sql_instances, CONTAINSSTRING(LOWER(view_sql_instances[sql_edition]), \"enterprise\"))",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Arc SQL Strategy",
            "lineageTag": "befbc92a-630c-41e0-9c3f-f9852e7968b4"
          },
          {
            "name": "kpi_mi_ready_sql_instance_count",
            "description": "Arc-enabled SQL instances reported as ready or conditionally ready for Azure SQL Managed Instance.",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS(view_sql_instances),",
              "    view_sql_instances[platform] = \"Arc\",",
              "    FILTER(",
              "        view_sql_instances,",
              "        LOWER(view_sql_instances[mi_status]) IN { \"ready\", \"suitable\", \"conditionallysuitable\", \"readywithconditions\", \"conditionally ready\", \"ready with conditions\" }",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Arc SQL Strategy",
            "lineageTag": "e4c595f0-c12e-40b6-85a7-30f60b218ca0"
          },
          {
            "name": "kpi_patch_assessed_machine_count",
            "description": "Arc-enabled machines with a current Azure Update Manager assessment summary in Resource Graph.",
            "expression": "DISTINCTCOUNT(view_patch_assessment_summary[machine_resource_id])",
            "formatString": "#,##0",
            "displayFolder": "Arc SQL Strategy",
            "lineageTag": "d9e01e76-22a4-444d-9d31-d8da2df6ede6"
          },
          {
            "name": "kpi_patch_assessment_coverage_pct",
            "description": "Share of Arc-enabled servers covered by current Update Manager assessment data.",
            "expression": "DIVIDE([kpi_patch_assessed_machine_count], [kpi_arc_server_count])",
            "formatString": "0.0%",
            "displayFolder": "Arc SQL Strategy",
            "lineageTag": "43a783eb-3627-4868-bd49-212698a5a66c"
          },
          {
            "name": "kpi_missing_patch_count",
            "description": "Total missing software patches reported by Update Manager assessment data.",
            "expression": "COUNTROWS(view_missing_patches)",
            "formatString": "#,##0",
            "displayFolder": "Arc SQL Strategy",
            "lineageTag": "5a3e0cc8-d42d-41a3-8330-181ae82fe7a1"
          },
          {
            "name": "kpi_missing_security_patch_count",
            "description": "Missing patches whose Update Manager classification contains Security.",
            "expression": [
              "COUNTROWS(",
              "    FILTER(",
              "        view_missing_patches,",
              "        CONTAINSSTRING(LOWER(view_missing_patches[classification]), \"security\")",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Arc SQL Strategy",
            "lineageTag": "4e8cbc17-1fa9-4b98-bc47-cb3523016661"
          },
          {
            "name": "kpi_missing_critical_patch_count",
            "description": "Missing patches whose Update Manager classification contains Critical.",
            "expression": [
              "COUNTROWS(",
              "    FILTER(",
              "        view_missing_patches,",
              "        CONTAINSSTRING(LOWER(view_missing_patches[classification]), \"critical\")",
              "    )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Arc SQL Strategy",
            "lineageTag": "bd76ef00-29a2-4414-b501-d8d6f785c2d3"
          },
          {
            "name": "kpi_migrate_project_count",
            "description": "Azure Migrate project containers discovered in the selected Resource Graph scope.",
            "expression": "COUNTROWS(view_migrate_projects)",
            "formatString": "#,##0",
            "displayFolder": "Arc SQL Strategy",
            "lineageTag": "00b1085d-dc49-44c1-8938-b2098ed20468"
          },
          {
            "name": "kpi_arg_subscription_count",
            "description": "Subscriptions returning Arc machine or Arc-enabled SQL resources in the Resource Graph scope validation query.",
            "expression": "DISTINCTCOUNT(view_arg_scope_validation[subscription_id])",
            "formatString": "#,##0",
            "displayFolder": "Arc SQL Strategy",
            "lineageTag": "0f68606e-c0eb-4af6-86fb-df06da3e3b16"
          },
          {
            "name": "kpi_mapped_cve_count",
            "description": "Distinct CVEs mapped from currently missing patches through MSRC.",
            "expression": "DISTINCTCOUNT ( 'view_patch_cve_mappings'[cve_id] )",
            "formatString": "#,##0",
            "displayFolder": "Security Audit",
            "lineageTag": "9e8cebc6-5b2a-4a6e-9353-726dcd9c153b"
          },
          {
            "name": "kpi_cve_affected_machine_count",
            "description": "Machines affected by at least one missing patch with an authoritative CVE mapping.",
            "expression": "DISTINCTCOUNT ( 'view_patch_cve_mappings'[machine_name] )",
            "formatString": "#,##0",
            "displayFolder": "Security Audit",
            "lineageTag": "910672d7-bd7a-44c1-be4f-ed6692059722"
          },
          {
            "name": "kpi_bpa_fail_count",
            "description": "Number of failed best-practice check results.",
            "expression": "CALCULATE ( COUNTROWS ( 'view_best_practice_findings' ), KEEPFILTERS ( 'view_best_practice_findings'[status] = \"Fail\" ) )",
            "formatString": "#,##0",
            "displayFolder": "Best Practices",
            "lineageTag": "8fdb6f72-7c8f-4eb2-b9e4-29444f44c1c0"
          },
          {
            "name": "kpi_bpa_warning_count",
            "description": "Number of warning best-practice check results.",
            "expression": "CALCULATE ( COUNTROWS ( 'view_best_practice_findings' ), KEEPFILTERS ( 'view_best_practice_findings'[status] = \"Warning\" ) )",
            "formatString": "#,##0",
            "displayFolder": "Best Practices",
            "lineageTag": "0f9b0883-0344-4494-a7b8-f5ba8d7e4df5"
          },
          {
            "name": "kpi_bpa_not_assessed_count",
            "description": "Number of best-practice check results that could not be assessed from connected evidence.",
            "expression": "CALCULATE ( COUNTROWS ( 'view_best_practice_findings' ), KEEPFILTERS ( 'view_best_practice_findings'[status] = \"Not Assessed\" ) )",
            "formatString": "#,##0",
            "displayFolder": "Best Practices",
            "lineageTag": "87acadcf-b7ee-4cc4-8ce6-6e584d260fd3"
          },
          {
            "name": "kpi_bpa_affected_machine_count",
            "description": "Distinct machines with at least one failed or warning best-practice result.",
            "expression": "CALCULATE ( DISTINCTCOUNT ( 'view_best_practice_findings'[machine_name] ), KEEPFILTERS ( 'view_best_practice_findings'[status] IN { \"Fail\", \"Warning\" } ) )",
            "formatString": "#,##0",
            "displayFolder": "Best Practices",
            "lineageTag": "777a2da7-1a94-48df-9b57-bb25a281c75c"
          },
          {
            "name": "kpi_bpa_check_count",
            "description": "Distinct best-practice checks represented in the connected evidence.",
            "expression": "DISTINCTCOUNT ( 'view_best_practice_findings'[check_id] )",
            "formatString": "#,##0",
            "displayFolder": "Best Practices",
            "lineageTag": "24c330ac-c4d0-4018-b8c8-ef84db46bc4f"
          },
          {
            "name": "kpi_bpa_finding_count",
            "description": "Number of best-practice check results in the current filter context.",
            "expression": "COUNTROWS ( 'view_best_practice_findings' )",
            "formatString": "#,##0",
            "displayFolder": "Best Practices",
            "lineageTag": "47dfd766-d608-4b8c-8672-bc0c853c5365"
          }
        ],
